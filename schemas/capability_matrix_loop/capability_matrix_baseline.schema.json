{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "artifact_type", "stage_id", "status", "created_at", "capabilities"],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "capability_matrix_baseline"},
    "stage_id": {"type": "string", "const": "CML00_CAPABILITY_LOOP_BOOTSTRAP"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "created_at": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability", "scale_nodes", "status", "evidence_paths"],
        "properties": {
          "capability": {"type": "string", "minLength": 1},
          "scale_nodes": {"type": "integer", "minimum": 0},
          "status": {"type": "string", "enum": ["PASS", "PARTIAL", "MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_EVIDENCE", "ABSENT_OBSERVED"]},
          "evidence_paths": {"type": "array", "items": {"type": "string"}},
          "missing_or_partial": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
