{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "stage_id", "files"],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "stage_id": {"type": "string", "pattern": "^CML[0-9]{2}_[A-Z0-9_]+$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "purpose", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["manifest", "state", "lock", "schema", "runner", "test", "artifact", "audit"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
