{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "artifact_type", "stage_id", "status", "created_at", "capabilities"],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "capability_matrix"},
    "stage_id": {"type": "string", "pattern": "^CML[0-9]{2}_[A-Z0-9_]+$"},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL"]},
    "created_at": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability_id", "status", "scale_nodes", "real_valkey_required", "evidence_chain"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_EVIDENCE", "ABSENT_OBSERVED"]},
          "scale_nodes": {"type": "integer", "minimum": 0, "maximum": 100},
          "real_valkey_required": {"type": "boolean"},
          "windows": {"type": "array", "items": {"type": "string"}},
          "evidence_chain": {
            "type": "object",
            "required": ["operation_events", "fault_events", "metrics_windows", "workload_windows", "analysis_summary", "report_index"],
            "properties": {
              "operation_events": {"type": "string", "minLength": 1},
              "fault_events": {"type": "string", "minLength": 1},
              "metrics_windows": {"type": "string", "minLength": 1},
              "workload_windows": {"type": "string", "minLength": 1},
              "analysis_summary": {"type": "string", "minLength": 1},
              "report_index": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
