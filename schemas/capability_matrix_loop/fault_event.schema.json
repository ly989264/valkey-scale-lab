{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "artifact_type", "stage_id", "fault_id", "window_id", "status", "source_stage", "current_stage", "observed_at", "evidence"],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "fault_event"},
    "stage_id": {"type": "string", "pattern": "^CML[0-9]{2}_[A-Z0-9_]+$"},
    "fault_id": {"type": "string", "minLength": 1},
    "fault_type": {"type": "string", "minLength": 1},
    "window_id": {"type": "string", "enum": ["before", "operation_or_fault_apply", "during", "clear_or_recovery_start", "after_recovery", "all_run"]},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_EVIDENCE", "ABSENT_OBSERVED"]},
    "source_stage": {"type": "string", "minLength": 1},
    "current_stage": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "evidence": {"type": "object"}
  },
  "additionalProperties": true
}
