{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "artifact_type", "stage_id", "status", "created_at", "checks", "negative_cases"],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "capability_stage_gate_result"},
    "stage_id": {"type": "string", "pattern": "^CML[0-9]{2}_[A-Z0-9_]+$"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "created_at": {"type": "string", "minLength": 1},
    "checks": {"type": "array", "items": {"type": "object"}},
    "negative_cases": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": true
}
