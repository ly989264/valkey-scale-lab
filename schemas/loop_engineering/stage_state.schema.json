{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loop Engineering Stage State",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "status",
    "phase",
    "started_at",
    "updated_at",
    "branch",
    "base_head",
    "current_head",
    "constraints",
    "blockers",
    "files_touched"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "stage_id": {"type": "string", "pattern": "^L[0-9]{2}_[A-Z0-9_]+$"},
    "status": {"type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "PASS", "BLOCKED"]},
    "phase": {
      "type": "string",
      "enum": [
        "READ_CONTEXT",
        "PREVIOUS_HARNESS",
        "DESIGN",
        "HARNESS",
        "IMPLEMENT",
        "REVIEW",
        "VALIDATE",
        "COMMIT",
        "PUSH",
        "PASS",
        "BLOCKED"
      ]
    },
    "started_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "base_head": {"type": "string"},
    "current_head": {"type": "string"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "files_touched": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
