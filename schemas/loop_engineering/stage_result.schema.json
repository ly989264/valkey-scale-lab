{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loop Engineering Stage Result",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "status",
    "completed_at",
    "commit_sha",
    "pushed",
    "previous_harness_passed",
    "current_harness_passed",
    "subagent_verdicts",
    "commands_log",
    "artifacts",
    "metrics_added",
    "visualizations_added",
    "real_valkey_gates",
    "fake_gates",
    "known_missing_metrics",
    "risks_remaining"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "stage_id": {"type": "string", "pattern": "^L[0-9]{2}_[A-Z0-9_]+$"},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
    "completed_at": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string"},
    "pushed": {"type": "boolean"},
    "previous_harness_passed": {"type": "boolean"},
    "current_harness_passed": {"type": "boolean"},
    "subagent_verdicts": {
      "type": "object",
      "properties": {
        "requirements_analyst": {"type": "string", "enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED"]},
        "harness_architect": {"type": "string", "enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED"]},
        "risk_auditor": {"type": "string", "enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED"]},
        "implementation_worker": {"type": "string", "enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED"]},
        "review_agent": {"type": "string", "enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED"]},
        "validation_agent": {"type": "string", "enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED"]},
        "anti_regression_guardian": {"type": "string", "enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED"]}
      },
      "additionalProperties": false
    },
    "commands_log": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "metrics_added": {"type": "array", "items": {"type": "string"}},
    "visualizations_added": {"type": "array", "items": {"type": "string"}},
    "real_valkey_gates": {"type": "array", "items": {"type": "string"}},
    "fake_gates": {"type": "array", "items": {"type": "string"}},
    "known_missing_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "status", "reason"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["MISSING", "SKIPPED_WITH_REASON"]},
          "reason": {"type": "string", "minLength": 1},
          "value": {"type": ["null", "string", "number", "boolean", "object", "array"]},
          "impact": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "risks_remaining": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
