{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loop Engineering Subagent Response",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "agent_role",
    "created_at",
    "context_files_read",
    "findings",
    "proposed_harness",
    "implementation_plan",
    "acceptance_criteria",
    "risks",
    "forbidden_shortcuts",
    "commands_to_run",
    "verdict",
    "notes"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "stage_id": {"type": "string", "pattern": "^L[0-9]{2}_[A-Z0-9_]+$"},
    "agent_role": {
      "type": "string",
      "enum": [
        "requirements_analyst",
        "harness_architect",
        "risk_auditor",
        "implementation_worker",
        "review_agent",
        "validation_agent",
        "anti_regression_guardian"
      ]
    },
    "created_at": {"type": "string", "minLength": 1},
    "context_files_read": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "purpose", "key_findings"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string"},
          "key_findings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "description", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "proposed_harness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "expected_to_fail_before_impl", "acceptance"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {
            "type": "string",
            "enum": ["unit", "integration", "cli", "schema", "artifact", "real_valkey", "ci"]
          },
          "expected_to_fail_before_impl": {"type": "boolean"},
          "acceptance": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "implementation_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "files", "rationale"],
        "properties": {
          "step": {"type": "string", "minLength": 1},
          "files": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "forbidden_shortcuts": {"type": "array", "items": {"type": "string"}},
    "commands_to_run": {"type": "array", "items": {"type": "string"}},
    "verdict": {"type": "string", "enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
