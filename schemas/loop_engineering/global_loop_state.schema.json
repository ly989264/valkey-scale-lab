{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loop Engineering Global Loop State",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "branch",
    "last_updated_at",
    "current_stage",
    "stages",
    "blockers",
    "latest_report_index"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "project": {"type": "string", "const": "valkey-scale-lab"},
    "branch": {"type": "string", "minLength": 1},
    "last_updated_at": {"type": "string", "minLength": 1},
    "current_stage": {"type": "string"},
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_id", "status", "commit_sha", "pushed", "result_path"],
        "properties": {
          "stage_id": {"type": "string", "pattern": "^L[0-9]{2}_[A-Z0-9_]+$"},
          "status": {"type": "string", "enum": ["PASS", "IN_PROGRESS", "BLOCKED", "NOT_STARTED"]},
          "commit_sha": {"type": "string"},
          "pushed": {"type": "boolean"},
          "result_path": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "latest_report_index": {"type": "string"}
  },
  "additionalProperties": false
}
