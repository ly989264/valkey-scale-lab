{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loop Engineering Previous Harness Result",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "status",
    "completed_at",
    "commands_log",
    "commands",
    "all_required_baseline_commands_passed"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "stage_id": {"type": "string", "pattern": "^L[0-9]{2}_[A-Z0-9_]+$"},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
    "completed_at": {"type": "string", "minLength": 1},
    "environment_notes": {"type": "array", "items": {"type": "string"}},
    "commands_log": {"type": "string", "minLength": 1},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED_WITH_REASON"]}
        },
        "additionalProperties": true
      }
    },
    "all_required_baseline_commands_passed": {"type": "boolean"}
  },
  "additionalProperties": false
}
