{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Final Audit Report",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "stage_id",
    "root_commit_sha",
    "created_at",
    "producer",
    "status",
    "summary",
    "source_artifacts",
    "generated_reports",
    "invariant_results",
    "missing_metric_impacts",
    "p14_boundary",
    "findings"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "final_audit_report"},
    "stage_id": {"type": "string", "const": "L10_FULL_CHAIN_FINAL_AUDIT_AND_VISUALIZATION_GATE"},
    "root_commit_sha": {"type": "string", "minLength": 7},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "summary": {
      "type": "object",
      "required": [
        "source_artifact_count",
        "generated_report_count",
        "invariant_count",
        "missing_metric_impact_count",
        "blocking_findings_count"
      ],
      "additionalProperties": true
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "artifact_type", "status", "source_of_truth"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 64},
          "artifact_type": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "source_of_truth": {"type": "boolean", "const": true}
        },
        "additionalProperties": true
      }
    },
    "generated_reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "role", "source_of_truth", "source_artifacts"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 64},
          "role": {"type": "string", "minLength": 1},
          "source_of_truth": {"type": "boolean", "const": false},
          "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "invariant_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "description"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["PASS", "FAIL"]},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "missing_metric_impacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "status", "reason", "impact", "source_artifact", "source_pointer", "evidence_layer", "dry_run_only"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["MISSING", "SKIPPED_WITH_REASON", "NO_BASELINE_YET"]},
          "reason": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "source_artifact": {"type": "string", "minLength": 1},
          "source_pointer": {"type": "string", "minLength": 1},
          "evidence_layer": {"type": "string", "minLength": 1},
          "dry_run_only": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "p14_boundary": {
      "type": "object",
      "required": ["status", "dry_run_only", "real_valkey_coverage"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "dry_run_only": {"type": "boolean", "const": true},
        "real_valkey_coverage": {"type": "boolean", "const": false}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "blocking", "description", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "category": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
