{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Loop Rolling Restart Result",
  "type": "object",
  "required": ["schema_version", "phase_id", "run_id", "node_logical_id", "restart_started_at_ms", "restart_completed_at_ms", "health_gate_status", "workload_impact_ref"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "node_logical_id": {"type": "string", "minLength": 1},
    "restart_started_at_ms": {"type": ["integer", "string"]},
    "restart_completed_at_ms": {"type": ["integer", "string"]},
    "health_gate_status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON"]},
    "workload_impact_ref": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
