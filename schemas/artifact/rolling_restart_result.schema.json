{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Loop Rolling Restart Result",
  "type": "object",
  "required": [
    "schema_version",
    "phase_id",
    "run_id",
    "operation_id",
    "operation_name",
    "node_count",
    "sequence",
    "node_logical_id",
    "planned_role",
    "role_before_restart",
    "max_concurrent_restarts",
    "restart_started_at_ms",
    "restart_completed_at_ms",
    "health_gate_started_at_ms",
    "health_gate_completed_at_ms",
    "health_gate_status",
    "cluster_state_after_gate",
    "known_nodes_after_gate",
    "slots_after_gate",
    "command_ref",
    "command_status",
    "workload_impact_ref"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "operation_name": {"type": "string", "enum": ["rolling_restart_replica_first", "rolling_restart_primary_safe"]},
    "node_count": {"type": "integer", "enum": [6, 10]},
    "sequence": {"type": "integer", "minimum": 1},
    "node_logical_id": {"type": "string", "minLength": 1},
    "planned_role": {"type": "string", "enum": ["primary", "replica"]},
    "role_before_restart": {"type": "string", "enum": ["primary", "replica", "unknown"]},
    "max_concurrent_restarts": {"type": "integer", "const": 1},
    "restart_started_at_ms": {"type": "integer"},
    "restart_completed_at_ms": {"type": "integer"},
    "health_gate_started_at_ms": {"type": "integer"},
    "health_gate_completed_at_ms": {"type": "integer"},
    "health_gate_status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON"]},
    "cluster_state_after_gate": {"type": "string", "minLength": 1},
    "known_nodes_after_gate": {"type": "integer", "minimum": 1},
    "slots_after_gate": {"type": "integer", "minimum": 0},
    "command_ref": {"type": "string", "minLength": 1},
    "command_status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "primary_safe_path": {"type": "string", "minLength": 1},
    "promotion_latency_ms": {"type": ["number", "string"]},
    "cluster_recovery_latency_ms": {"type": ["number", "string"]},
    "read_unavailability_ms": {"type": ["number", "string"]},
    "write_unavailability_ms": {"type": ["number", "string"]},
    "missing_fields": {"type": "array", "items": {"type": "object"}},
    "workload_impact_ref": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
