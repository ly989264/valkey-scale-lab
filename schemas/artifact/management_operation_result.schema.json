{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Management Operation Result",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "scenario",
    "coverage_id",
    "operation_name",
    "operation_id",
    "node_count",
    "scale",
    "operation_status",
    "status_reason",
    "started_at_unix_ms",
    "ended_at_unix_ms",
    "operation_duration_ms",
    "wall_ms",
    "prepare_ms",
    "command_ms",
    "convergence_ms",
    "cleanup_ms",
    "before_topology_snapshot",
    "after_topology_snapshot",
    "before_topology_snapshot_ref",
    "after_topology_snapshot_ref",
    "topology_diff",
    "topology_diff_ref",
    "slot_diff",
    "role_diff",
    "cluster_state_before",
    "cluster_state_after",
    "known_nodes_before",
    "known_nodes_after",
    "fail_pfail_handshake_before",
    "fail_pfail_handshake_after",
    "command_count",
    "retry_count",
    "error_count",
    "command_log_refs",
    "workload_impact_ref",
    "cleanup_ref",
    "source_evidence_refs",
    "missing_fields"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "management_operation_result"},
    "phase_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "coverage_id": {"type": "string", "minLength": 1},
    "operation_name": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "node_count": {"type": "integer", "minimum": 1},
    "scale": {"type": "integer", "minimum": 1},
    "operation_status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_REASON", "PASS_NOOP_VERIFIED", "BLOCKED_WITH_REASON"]},
    "status_reason": {"type": "string", "minLength": 1},
    "started_at_unix_ms": {"type": "integer"},
    "ended_at_unix_ms": {"type": "integer"},
    "operation_duration_ms": {"type": "number"},
    "wall_ms": {"type": "number"},
    "prepare_ms": {"type": "number"},
    "command_ms": {"type": "number"},
    "convergence_ms": {"type": "number"},
    "cleanup_ms": {"type": "number"},
    "before_topology_snapshot": {"type": "object"},
    "after_topology_snapshot": {"type": "object"},
    "before_topology_snapshot_ref": {"type": "string", "minLength": 1},
    "after_topology_snapshot_ref": {"type": "string", "minLength": 1},
    "topology_diff": {"type": "object"},
    "topology_diff_ref": {"type": "string", "minLength": 1},
    "slot_diff": {"type": "object"},
    "role_diff": {"type": "object"},
    "cluster_state_before": {"type": "string", "minLength": 1},
    "cluster_state_after": {"type": "string", "minLength": 1},
    "known_nodes_before": {"type": "integer", "minimum": 0},
    "known_nodes_after": {"type": "integer", "minimum": 0},
    "fail_pfail_handshake_before": {"type": "object"},
    "fail_pfail_handshake_after": {"type": "object"},
    "command_count": {"type": "integer", "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0},
    "error_count": {"type": "integer", "minimum": 0},
    "command_log_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "workload_impact_ref": {"type": "string", "minLength": 1},
    "cleanup_ref": {"type": "string", "minLength": 1},
    "source_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "missing_fields": {"type": "array", "items": {"type": "object"}},
    "bytes_migrated": {
      "oneOf": [
        {"type": "number"},
        {
          "type": "object",
          "required": ["status", "field", "reason", "impact"],
          "properties": {
            "status": {"type": "string", "enum": ["MISSING", "SKIPPED_WITH_REASON"]},
            "field": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1},
            "impact": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
