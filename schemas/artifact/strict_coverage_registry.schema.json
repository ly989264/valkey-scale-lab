{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strict Coverage Registry",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "stage_id",
    "created_at",
    "producer",
    "source_spec_refs",
    "summary",
    "rows"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "strict_coverage_registry"},
    "stage_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "source_spec_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "summary": {
      "type": "object",
      "required": [
        "total_rows",
        "expected_total_rows",
        "expected_counts",
        "counts_by_category",
        "counts_by_execution_mode",
        "counts_by_status",
        "counts_by_stage_owner",
        "real_rows_initial_status",
        "dry_run_rows_initial_status",
        "real_runtime_claimed",
        "real_execution_above_200_permitted"
      ],
      "properties": {
        "total_rows": {"type": "integer", "minimum": 1},
        "expected_total_rows": {"type": "integer", "minimum": 1},
        "expected_counts": {"type": "object"},
        "counts_by_category": {"type": "object"},
        "counts_by_execution_mode": {"type": "object"},
        "counts_by_status": {"type": "object"},
        "counts_by_stage_owner": {"type": "object"},
        "real_rows_initial_status": {"type": "string", "const": "PENDING"},
        "dry_run_rows_initial_status": {"type": "string", "const": "PENDING"},
        "real_runtime_claimed": {"type": "boolean", "const": false},
        "real_execution_above_200_permitted": {"type": "boolean", "const": false}
      },
      "additionalProperties": true
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "coverage_id",
          "scale",
          "node_count",
          "category",
          "row_name",
          "stage_owner",
          "required",
          "execution_mode",
          "status",
          "status_reason",
          "source_artifacts",
          "validation_artifacts",
          "metric_refs",
          "cleanup_ref",
          "review_ref",
          "commit_sha"
        ],
        "properties": {
          "coverage_id": {
            "type": "string",
            "pattern": "^(50|100|200|201|250|300|500|1000)\\.(lifecycle|management|fault|dry_run)\\.[a-z0-9_]+$"
          },
          "scale": {"type": "integer", "enum": [50, 100, 200, 201, 250, 300, 500, 1000]},
          "node_count": {"type": "integer", "enum": [50, 100, 200, 201, 250, 300, 500, 1000]},
          "category": {"type": "string", "enum": ["lifecycle", "management", "fault", "dry_run"]},
          "row_name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "stage_owner": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
          "required": {"type": "boolean"},
          "execution_mode": {"type": "string", "enum": ["real", "dry_run"]},
          "status": {"type": "string", "enum": ["PENDING", "PASS", "FAIL", "BLOCKED", "DRY_RUN_PASS", "MISSING"]},
          "status_reason": {"type": "string", "minLength": 1},
          "source_artifacts": {"type": "array", "items": {"type": "string"}},
          "validation_artifacts": {"type": "array", "items": {"type": "string"}},
          "metric_refs": {"type": "array", "items": {"type": "string"}},
          "cleanup_ref": {"type": "string"},
          "review_ref": {"type": "string"},
          "commit_sha": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
