{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Loop Final Report Index",
  "type": "object",
  "required": ["schema_version", "artifact_type", "phase_id", "run_id", "reports", "source_artifacts"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "final_report_index"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "reports": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
