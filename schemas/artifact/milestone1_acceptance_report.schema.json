{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Milestone1 Acceptance Report",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "stage_id",
    "milestone1_status",
    "cluster_setup",
    "management_ops",
    "fault_failover",
    "workload_benchmark",
    "system_metrics",
    "analysis",
    "visual_report_zh",
    "cleanup",
    "cross_scenario_coverage",
    "category_results"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "milestone1_acceptance_report"},
    "stage_id": {"type": "string", "const": "M1-S09"},
    "milestone1_status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED_WITH_REASON"]},
    "cluster_setup": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED_WITH_REASON"]},
    "management_ops": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED_WITH_REASON"]},
    "fault_failover": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED_WITH_REASON"]},
    "workload_benchmark": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED_WITH_REASON"]},
    "system_metrics": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED_WITH_REASON"]},
    "analysis": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED_WITH_REASON"]},
    "visual_report_zh": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED_WITH_REASON"]},
    "cleanup": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED_WITH_REASON"]},
    "cross_scenario_coverage": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED_WITH_REASON"]},
    "category_results": {"type": "object"},
    "heavy_real_rungs": {"type": "array"},
    "source_artifacts": {"type": "array"}
  },
  "additionalProperties": true
}
