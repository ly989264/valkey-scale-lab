{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase Summary",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "created_at",
    "producer",
    "status",
    "summary",
    "required_artifacts",
    "missing_metrics",
    "risks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v1$"
    },
    "artifact_type": {
      "type": "string",
      "const": "phase_summary"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "MISSING",
        "SKIPPED_WITH_REASON",
        "NO_BASELINE_YET"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "status",
          "reason"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "MISSING",
              "SKIPPED_WITH_REASON"
            ]
          },
          "reason": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
