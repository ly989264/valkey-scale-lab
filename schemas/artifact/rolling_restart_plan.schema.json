{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Loop Rolling Restart Plan",
  "type": "object",
  "required": ["schema_version", "artifact_type", "phase_id", "run_id", "restart_order", "health_gate"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "rolling_restart_plan"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "restart_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "health_gate": {"type": "object"}
  },
  "additionalProperties": true
}
