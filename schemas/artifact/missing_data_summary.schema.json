{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Loop Missing Data Summary",
  "type": "object",
  "required": ["schema_version", "artifact_type", "phase_id", "run_id", "items"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "missing_data_summary"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "field", "status", "reason"],
        "properties": {
          "artifact": {"type": "string", "minLength": 1},
          "field": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_REASON"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
