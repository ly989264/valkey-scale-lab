{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P13 Optimization Phase Summary",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "artifact_phase_id",
    "run_id",
    "created_at",
    "producer",
    "status",
    "summary",
    "required_artifacts",
    "real_valkey_evidence",
    "timing_accounting"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "p13_optimization_phase_summary"},
    "phase_id": {"type": "string", "pattern": "^P13O-[0-9]{2}_[A-Z0-9_]+$"},
    "artifact_phase_id": {"type": "string", "pattern": "^P13O_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {"type": "object"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "summary": {"type": "string", "minLength": 1},
    "required_artifacts": {"type": "array"},
    "real_valkey_evidence": {"type": "object"},
    "timing_accounting": {"type": "object"}
  },
  "additionalProperties": true
}
