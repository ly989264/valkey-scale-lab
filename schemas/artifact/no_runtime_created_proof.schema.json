{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "No Runtime Created Proof",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "status",
    "execution_mode",
    "runtime_resources_created",
    "before_inventory",
    "after_inventory"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "no_runtime_created_proof"},
    "phase_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "const": "PASS"},
    "execution_mode": {"type": "string", "const": "dry_run"},
    "runtime_resources_created": {"type": "boolean", "const": false},
    "before_inventory": {"type": "object"},
    "after_inventory": {"type": "object"}
  },
  "additionalProperties": true
}
