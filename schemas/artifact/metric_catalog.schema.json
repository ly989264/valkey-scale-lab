{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "created_at",
    "producer",
    "status",
    "summary",
    "metrics",
    "findings"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "metric_catalog"},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL"]},
    "summary": {
      "type": "object",
      "required": [
        "metric_count",
        "measured_count",
        "missing_count",
        "skipped_count",
        "no_baseline_count",
        "blocking_findings_count",
        "surfaces",
        "layers"
      ],
      "properties": {
        "metric_count": {"type": "integer", "minimum": 1},
        "measured_count": {"type": "integer", "minimum": 0},
        "missing_count": {"type": "integer", "minimum": 0},
        "skipped_count": {"type": "integer", "minimum": 0},
        "no_baseline_count": {"type": "integer", "minimum": 0},
        "blocking_findings_count": {"type": "integer", "minimum": 0},
        "surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "layers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "surface",
          "unit",
          "source_artifact",
          "source_sha256",
          "source_artifact_type",
          "source_kind",
          "source_pointer",
          "phase_id",
          "run_id",
          "scenario",
          "node_count_scope",
          "evidence_layer",
          "evidence_class",
          "real_valkey_coverage",
          "dry_run_only",
          "value_status",
          "value",
          "missing_semantics"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "surface": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "source_artifact": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "minLength": 1},
          "source_artifact_type": {"type": "string", "minLength": 1},
          "source_kind": {"type": "string", "minLength": 1},
          "source_pointer": {"type": "string", "minLength": 1},
          "phase_id": {"type": "string", "minLength": 1},
          "run_id": {"type": ["string", "null"]},
          "scenario": {"type": ["string", "null"]},
          "node_count_scope": {"type": "string", "minLength": 1},
          "evidence_layer": {"type": "string", "enum": ["fake", "small-real", "30", "50", "100", "1000-dry-run"]},
          "evidence_class": {"type": "string", "enum": ["fake", "real_valkey", "dry_run_planner", "source_artifact", "report_view"]},
          "real_valkey_coverage": {"type": "boolean"},
          "dry_run_only": {"type": "boolean"},
          "value_status": {"type": "string", "enum": ["MEASURED", "PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON", "NO_BASELINE_YET"]},
          "missing_semantics": {
            "type": "object",
            "required": ["status", "reason"],
            "properties": {
              "status": {"type": "string", "enum": ["PRESENT", "MISSING", "SKIPPED_WITH_REASON", "NO_BASELINE_YET"]},
              "reason": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "blocking", "description", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "category": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
