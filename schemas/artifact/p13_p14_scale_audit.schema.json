{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P13/P14 Scale Audit",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "created_at",
    "producer",
    "status",
    "summary",
    "p13",
    "p14_boundary",
    "findings"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "p13_p14_scale_audit"},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL"]},
    "summary": {
      "type": "object",
      "required": [
        "blocking_findings_count",
        "p13_rung_count",
        "p13_real_evidence_count",
        "p13_canonical_node_counts",
        "p14_status",
        "p14_real_evidence_count",
        "p14_dry_run_only"
      ],
      "properties": {
        "blocking_findings_count": {"type": "integer", "minimum": 0},
        "p13_rung_count": {"type": "integer", "minimum": 0},
        "p13_real_evidence_count": {"type": "integer", "minimum": 0},
        "p13_canonical_node_counts": {"type": "array", "items": {"type": "integer"}},
        "p14_status": {"type": "string"},
        "p14_real_evidence_count": {"type": "integer", "minimum": 0},
        "p14_dry_run_only": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "p13": {
      "type": "object",
      "required": [
        "phase_id",
        "status",
        "canonical_artifact_dir",
        "rungs",
        "scale_report",
        "gate_compatibility",
        "optimization_artifacts",
        "required_artifacts"
      ],
      "properties": {
        "phase_id": {"type": "string", "const": "P13_SCALE_LADDER_50_100"},
        "status": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL"]},
        "canonical_artifact_dir": {"type": "string"},
        "rungs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "node_count",
              "scenario",
              "status",
              "evidence_path",
              "evidence_sha256",
              "timing_path",
              "scale_rung_path",
              "cleanup_path",
              "real_valkey",
              "nodes_observed",
              "probe_count",
              "failed_probe_count",
              "cluster_state_observed",
              "data_path_result",
              "valkey_versions",
              "timing_checks",
              "cleanup_checks",
              "scale_rung_checks",
              "findings"
            ],
            "properties": {
              "node_count": {"type": "integer", "enum": [50, 100]},
              "scenario": {"type": "string"},
              "status": {"type": "string"},
              "evidence_path": {"type": "string"},
              "evidence_sha256": {"type": "string"},
              "timing_path": {"type": "string"},
              "scale_rung_path": {"type": "string"},
              "cleanup_path": {"type": "string"},
              "real_valkey": {"type": "boolean"},
              "nodes_observed": {"type": "integer", "minimum": 0},
              "probe_count": {"type": "integer", "minimum": 0},
              "failed_probe_count": {"type": "integer", "minimum": 0},
              "cluster_state_observed": {"type": "string"},
              "data_path_result": {"type": "string"},
              "valkey_versions": {"type": "array", "items": {"type": "string"}},
              "findings": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        },
        "optimization_artifacts": {
          "type": "object",
          "required": ["classified_separately", "paths", "canonical_evidence_paths"],
          "properties": {
            "classified_separately": {"type": "boolean"},
            "paths": {"type": "array", "items": {"type": "string"}},
            "canonical_evidence_paths": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "p14_boundary": {
      "type": "object",
      "required": [
        "phase_id",
        "status",
        "automatic",
        "real_valkey_required",
        "max_nodes",
        "dry_run_only",
        "real_valkey_coverage",
        "opt_in_required",
        "default_gate_result_present",
        "real_evidence_count",
        "dry_run_artifacts",
        "reason"
      ],
      "properties": {
        "phase_id": {"type": "string", "const": "P14_SCALE_1000_OPTIN_DRYRUN"},
        "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED_WITH_REASON"]},
        "automatic": {"type": "boolean"},
        "real_valkey_required": {"type": "boolean"},
        "max_nodes": {"type": "integer", "const": 1000},
        "dry_run_only": {"type": "boolean"},
        "real_valkey_coverage": {"type": "boolean"},
        "opt_in_required": {"type": "boolean"},
        "default_gate_result_present": {"type": "boolean"},
        "real_evidence_count": {"type": "integer", "minimum": 0},
        "dry_run_artifacts": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "classification", "blocking", "description", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "category": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "enum": ["current", "historical", "informational"]},
          "blocking": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
