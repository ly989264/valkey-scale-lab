{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Valkey E2E Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "created_at",
    "producer",
    "status",
    "real_valkey",
    "valkey_version_prefix_required",
    "probe_result",
    "nodes_observed",
    "cluster_state_observed",
    "data_path_result",
    "probes",
    "cleanup"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v1$"
    },
    "artifact_type": {
      "type": "string",
      "const": "valkey_e2e_evidence"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "MISSING",
        "SKIPPED_WITH_REASON",
        "NO_BASELINE_YET"
      ]
    },
    "real_valkey": {
      "type": "boolean"
    },
    "valkey_version_prefix_required": {
      "type": "string",
      "const": "9.1."
    },
    "probe_result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "nodes_observed": {
      "type": "integer",
      "minimum": 1
    },
    "cluster_state_observed": {
      "type": "string",
      "enum": [
        "ok",
        "fail",
        "unknown"
      ]
    },
    "data_path_result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "SKIPPED_WITH_REASON"
      ]
    },
    "valkey_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "logical_id",
          "host",
          "port",
          "status"
        ],
        "properties": {
          "logical_id": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "version": {
            "type": "string"
          },
          "cluster_state": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "cleanup": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
