{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment Info",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "created_at",
    "producer",
    "status",
    "platform",
    "python_version",
    "docker_available",
    "default_node_cap"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v1$"
    },
    "artifact_type": {
      "type": "string",
      "const": "env_info"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "MISSING",
        "SKIPPED_WITH_REASON",
        "NO_BASELINE_YET"
      ]
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "python_version": {
      "type": "string",
      "minLength": 1
    },
    "docker_available": {
      "type": "boolean"
    },
    "valkey_image": {
      "type": "string"
    },
    "default_node_cap": {
      "type": "integer",
      "maximum": 100
    }
  },
  "additionalProperties": true
}
