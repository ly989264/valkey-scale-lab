{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client Recovery Sample",
  "type": "object",
  "required": [
    "schema_version",
    "phase_id",
    "run_id",
    "scenario_name",
    "sample_id",
    "timestamp_unix_ms",
    "monotonic_ms",
    "status",
    "probe_type",
    "fault_active",
    "key",
    "set_status",
    "get_status",
    "latency_ms",
    "moved_count",
    "ask_count",
    "timeout"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_name": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "timestamp_unix_ms": {"type": "integer"},
    "monotonic_ms": {"type": ["number", "integer"]},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "probe_type": {"type": "string", "const": "continuous_fault_period_set_get"},
    "fault_active": {"type": "boolean"},
    "key": {"type": "string", "minLength": 1},
    "set_status": {"type": "string", "minLength": 1},
    "get_status": {"type": "string", "minLength": 1},
    "latency_ms": {"type": ["number", "integer", "string"]},
    "moved_count": {"type": "integer", "minimum": 0},
    "ask_count": {"type": "integer", "minimum": 0},
    "timeout": {"type": "boolean"}
  },
  "additionalProperties": true
}
