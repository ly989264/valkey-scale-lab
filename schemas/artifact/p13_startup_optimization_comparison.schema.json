{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P13 Startup Optimization Comparison",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "created_at",
    "producer",
    "status",
    "budget_mode",
    "strict_env_var",
    "summary",
    "scenario_observations",
    "budget_results",
    "real_valkey_evidence",
    "safety_constraints",
    "source_artifacts",
    "errors"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "p13_startup_optimization_comparison"},
    "phase_id": {"type": "string", "const": "P13O-05_PERF_REGRESSION_BUDGET"},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {"type": "object"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "budget_mode": {"type": "string", "enum": ["warning", "strict"]},
    "strict_env_var": {"type": "string", "const": "VSLAB_STRICT_PERF_BUDGET"},
    "summary": {
      "type": "object",
      "required": [
        "scale_50_real_gate_duration_seconds",
        "scale_100_real_gate_duration_seconds",
        "scale_50_primary_cluster_create_seconds",
        "scale_100_primary_cluster_create_seconds",
        "scale_50_replica_replicate_seconds",
        "scale_100_replica_replicate_seconds",
        "scale_50_wrapper_probe_seconds",
        "scale_100_wrapper_probe_seconds",
        "scale_50_cleanup_seconds",
        "scale_100_cleanup_seconds",
        "scale_50_unattributed_seconds",
        "scale_100_unattributed_seconds",
        "overall_budget_status"
      ],
      "additionalProperties": true
    },
    "scenario_observations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "scenario",
          "node_count",
          "status",
          "real_valkey",
          "evidence_path",
          "timing_path",
          "cleanup_report_path",
          "metrics"
        ],
        "properties": {
          "scenario": {"type": "string", "enum": ["scale_50", "scale_100"]},
          "node_count": {"type": "integer", "minimum": 1, "maximum": 100},
          "status": {"type": "string", "enum": ["PASS", "FAIL"]},
          "real_valkey": {"type": ["boolean", "string"]},
          "evidence_path": {"type": "string", "minLength": 1},
          "timing_path": {"type": "string", "minLength": 1},
          "cleanup_report_path": {"type": "string", "minLength": 1},
          "metrics": {
            "type": "object",
            "required": [
              "scale_real_gate_duration_seconds",
              "primary_cluster_create_duration_seconds",
              "replica_replicate_duration_seconds",
              "wrapper_probe_duration_seconds",
              "cleanup_duration_seconds",
              "unattributed_seconds"
            ],
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "budget_results": {
      "type": "object",
      "required": ["overall_status", "strict_enabled", "results"],
      "properties": {
        "overall_status": {"type": "string", "enum": ["PASS", "WARN", "FAIL"]},
        "strict_enabled": {"type": "boolean"},
        "results": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": ["name", "metric", "scenario", "observed_seconds", "budget_seconds", "status", "strict_enabled"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "metric": {"type": "string", "minLength": 1},
              "scenario": {"type": "string", "enum": ["scale_50", "scale_100"]},
              "observed_seconds": {"type": ["number", "object"]},
              "budget_seconds": {"type": "number", "minimum": 0},
              "status": {"type": "string", "enum": ["PASS", "WARN", "FAIL"]},
              "strict_enabled": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "real_valkey_evidence": {"type": "object"},
    "safety_constraints": {
      "type": "object",
      "required": [
        "real_valkey_evidence_replaced",
        "fake_only_gate_used",
        "host_network_mutation",
        "p14_executed",
        "default_max_nodes"
      ],
      "properties": {
        "real_valkey_evidence_replaced": {"type": "boolean", "const": false},
        "fake_only_gate_used": {"type": "boolean", "const": false},
        "host_network_mutation": {"type": "boolean", "const": false},
        "p14_executed": {"type": "boolean", "const": false},
        "default_max_nodes": {"type": "integer", "maximum": 100}
      },
      "additionalProperties": true
    },
    "source_artifacts": {"type": "array"},
    "errors": {"type": "array"}
  },
  "additionalProperties": true
}
