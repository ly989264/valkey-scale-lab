{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross Stage Workload Impact",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "source_stage_statuses",
    "source_artifacts",
    "rows",
    "row_counts",
    "csv_exports",
    "derivation_rules"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "workload_impact_cross_stage"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "source_stage_statuses": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["stage_id", "category", "status", "row_count"],
        "properties": {
          "stage_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
          "category": {"type": "string", "enum": ["management", "failover", "fault"]},
          "status": {"type": "string", "enum": ["PASS", "MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_REASON"]},
          "row_count": {"type": "integer", "minimum": 0},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "row_id",
          "source_stage_id",
          "category",
          "status",
          "source_refs",
          "window_refs",
          "windows",
          "derived",
          "error_taxonomy"
        ],
        "properties": {
          "row_id": {"type": "string", "minLength": 1},
          "source_stage_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
          "category": {"type": "string", "enum": ["management", "failover", "fault"]},
          "status": {"type": "string", "enum": ["PASS", "MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_REASON", "FAIL"]},
          "reason": {"type": "string"},
          "source_refs": {"type": "array"},
          "window_refs": {"type": "object"},
          "windows": {"type": "object"},
          "derived": {"type": "object"},
          "error_taxonomy": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "row_counts": {
      "type": "object",
      "required": ["total", "management", "failover", "fault", "missing_rows", "p24_rows"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "management": {"type": "integer", "minimum": 0},
        "failover": {"type": "integer", "minimum": 0},
        "fault": {"type": "integer", "minimum": 0},
        "missing_rows": {"type": "integer", "minimum": 0},
        "p24_rows": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "csv_exports": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["table_name", "path", "row_count", "json_source_count", "json_source_artifact", "sha256"],
        "properties": {
          "table_name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "row_count": {"type": "integer", "minimum": 0},
          "json_source_count": {"type": "integer", "minimum": 0},
          "json_source_artifact": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "derivation_rules": {
      "type": "object",
      "required": ["inputs", "log_parsing", "source_scenarios_rerun"],
      "properties": {
        "inputs": {"type": "string", "minLength": 1},
        "log_parsing": {"type": "boolean"},
        "source_scenarios_rerun": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
