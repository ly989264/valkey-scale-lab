{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failover Timeline Sample",
  "type": "object",
  "required": [
    "schema_version",
    "phase_id",
    "run_id",
    "scenario_name",
    "sample_id",
    "status",
    "execution_mode",
    "real_valkey",
    "node_count",
    "scale",
    "fault_apply_at_ms",
    "target_process_gone_at_ms",
    "first_pfail_seen_at_ms",
    "first_fail_seen_at_ms",
    "first_promotion_seen_at_ms",
    "first_slots_covered_at_ms",
    "first_cluster_ok_at_ms",
    "first_client_success_at_ms",
    "clean_snapshot_passed_at_ms",
    "kill_to_pfail_ms",
    "pfail_to_cluster_ok_ms",
    "kill_to_client_recovered_ms",
    "cluster_ok_to_client_success_ms",
    "cluster_ok_to_clean_snapshot_ms",
    "kill_to_clean_snapshot_ms",
    "timeline_source",
    "client_probe_source",
    "first_client_success_source",
    "observer_samples_ref",
    "client_recovery_samples_ref"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_name": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON"]},
    "execution_mode": {"type": "string", "enum": ["real_valkey", "fake_schema", "dry_run_projection"]},
    "real_valkey": {"type": "boolean"},
    "node_count": {"type": "integer", "minimum": 1, "maximum": 200},
    "scale": {"type": "string", "minLength": 1},
    "fault_apply_at_ms": {"type": ["integer", "number", "string"]},
    "target_process_gone_at_ms": {"type": ["integer", "number", "string"]},
    "first_pfail_seen_at_ms": {"type": ["integer", "number", "string"]},
    "first_fail_seen_at_ms": {"type": ["integer", "number", "string"]},
    "first_promotion_seen_at_ms": {"type": ["integer", "number", "string"]},
    "first_slots_covered_at_ms": {"type": ["integer", "number", "string"]},
    "first_cluster_ok_at_ms": {"type": ["integer", "number", "string"]},
    "first_client_success_at_ms": {"type": ["integer", "number", "string"]},
    "clean_snapshot_passed_at_ms": {"type": ["integer", "number", "string"]},
    "kill_to_pfail_ms": {"type": ["number", "string"]},
    "pfail_to_cluster_ok_ms": {"type": ["number", "string"]},
    "kill_to_client_recovered_ms": {"type": ["number", "string"]},
    "cluster_ok_to_client_success_ms": {"type": ["number", "string"]},
    "cluster_ok_to_clean_snapshot_ms": {"type": ["number", "string"]},
    "kill_to_clean_snapshot_ms": {"type": ["number", "string"]},
    "timeline_source": {"type": "string", "minLength": 1},
    "client_probe_source": {"type": "string", "minLength": 1},
    "first_client_success_source": {"type": "string", "minLength": 1},
    "observer_samples_ref": {"type": "string", "minLength": 1},
    "client_recovery_samples_ref": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
