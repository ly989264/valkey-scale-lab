{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Provenance Graph",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "created_at",
    "producer",
    "status",
    "root_commit_sha",
    "manifest_sha256",
    "scope",
    "summary",
    "report_view_policy",
    "p14_boundary",
    "phase_coverage",
    "nodes",
    "edges",
    "findings"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "provenance_graph"},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL"]},
    "root_commit_sha": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["target_phase_ids", "automatic_phase_ids", "optional_phase_ids"],
      "properties": {
        "target_phase_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "automatic_phase_ids": {"type": "array", "items": {"type": "string"}},
        "optional_phase_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "node_count",
        "edge_count",
        "source_of_truth_node_count",
        "report_view_node_count",
        "blocking_findings_count",
        "missing_source_count",
        "hash_mismatch_count"
      ],
      "properties": {
        "node_count": {"type": "integer", "minimum": 0},
        "edge_count": {"type": "integer", "minimum": 0},
        "source_of_truth_node_count": {"type": "integer", "minimum": 0},
        "report_view_node_count": {"type": "integer", "minimum": 0},
        "blocking_findings_count": {"type": "integer", "minimum": 0},
        "missing_source_count": {"type": "integer", "minimum": 0},
        "hash_mismatch_count": {"type": "integer", "minimum": 0},
        "missing_metadata_count": {"type": "integer", "minimum": 0},
        "invalid_source_schema_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "report_view_policy": {
      "type": "object",
      "required": ["source_of_truth", "suffixes"],
      "properties": {
        "source_of_truth": {"type": "boolean"},
        "suffixes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "p14_boundary": {
      "type": "object",
      "required": ["phase_id", "automatic", "status", "real_valkey_coverage", "reason"],
      "properties": {
        "phase_id": {"type": "string"},
        "automatic": {"type": "boolean"},
        "status": {"type": "string", "enum": ["SKIPPED_WITH_REASON", "PASS", "FAIL"]},
        "real_valkey_coverage": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "phase_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase_id", "status", "required_paths", "covered_paths", "finding_ids"],
        "properties": {
          "phase_id": {"type": "string"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED_WITH_REASON"]},
          "required_paths": {"type": "array", "items": {"type": "string"}},
          "covered_paths": {"type": "array", "items": {"type": "string"}},
          "finding_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "exists",
          "sha256",
          "hash_status",
          "artifact_role",
          "source_of_truth",
          "artifact_type",
          "phase_id",
          "run_id",
          "producer",
          "status",
          "schema_path",
          "schema_sha256",
          "schema_valid",
          "metadata_status",
          "dry_run_only",
          "real_valkey_coverage"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "exists": {"type": "boolean"},
          "sha256": {"type": ["string", "null"]},
          "hash_status": {"type": "string", "enum": ["PRESENT", "MISSING"]},
          "artifact_role": {"type": "string", "minLength": 1},
          "source_of_truth": {"type": "boolean"},
          "artifact_type": {"type": ["string", "null"]},
          "phase_id": {"type": ["string", "null"]},
          "run_id": {"type": ["string", "null"]},
          "producer": {"type": ["object", "null"]},
          "status": {"type": ["string", "null"]},
          "schema_path": {"type": ["string", "null"]},
          "schema_sha256": {"type": ["string", "null"]},
          "schema_valid": {"type": ["boolean", "null"]},
          "metadata_status": {
            "type": "object",
            "required": ["artifact_type", "phase_id", "run_id", "producer", "status", "schema"],
            "properties": {
              "artifact_type": {"$ref": "#/$defs/metadataStatus"},
              "phase_id": {"$ref": "#/$defs/metadataStatus"},
              "run_id": {"$ref": "#/$defs/metadataStatus"},
              "producer": {"$ref": "#/$defs/metadataStatus"},
              "status": {"$ref": "#/$defs/metadataStatus"},
              "schema": {"$ref": "#/$defs/metadataStatus"}
            },
            "additionalProperties": true
          },
          "dry_run_only": {"type": "boolean"},
          "real_valkey_coverage": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_path",
          "target_path",
          "relation",
          "discovered_by",
          "evidence_pointer",
          "required",
          "status",
          "hash_status",
          "source_sha256",
          "target_sha256"
        ],
        "properties": {
          "source_path": {"type": "string", "minLength": 1},
          "target_path": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "minLength": 1},
          "discovered_by": {"type": "string", "minLength": 1},
          "evidence_pointer": {"type": "string"},
          "required": {"type": "boolean"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED_WITH_REASON"]},
          "hash_status": {"type": "string", "enum": ["MATCH", "MISMATCH", "MISSING", "NOT_DECLARED"]},
          "source_sha256": {"type": ["string", "null"]},
          "target_sha256": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "blocking", "description", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "category": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "phase_id": {"type": "string"},
          "path": {"type": "string"},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "metadataStatus": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PRESENT", "VALID", "INVALID", "MISSING", "SKIPPED_WITH_REASON"]
        },
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
