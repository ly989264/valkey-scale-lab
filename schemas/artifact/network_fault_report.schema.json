{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Network Fault Report",
  "type": "object",
  "required": ["schema_version", "artifact_type", "phase_id", "run_id", "network_faults"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "network_fault_report"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "network_faults": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": true
}
