{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M1 Fault Timeline Event",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "scenario_name",
    "sample_id",
    "fault_id",
    "fault_type",
    "node_count",
    "scale_rung",
    "event_name",
    "event_status",
    "timestamp_unix_ms",
    "monotonic_ms",
    "source",
    "subject_type",
    "subject_id",
    "real_valkey",
    "execution_mode",
    "reason"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "fault_timeline_event"},
    "phase_id": {"type": "string", "pattern": "^(M1-S[0-9]{2}|P[0-9]{2}_[A-Z0-9_]+)$"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_name": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "fault_id": {"type": "string", "minLength": 1},
    "fault_type": {
      "type": "string",
      "enum": [
        "primary_stop_failover",
        "replica_stop",
        "node_host_stop",
        "az_stop",
        "network_delay",
        "network_loss",
        "network_flap",
        "network_partition",
        "minority_partition",
        "majority_partition",
        "split_brain_window_detection",
        "fault_period_workload_impact"
      ]
    },
    "node_count": {"type": "integer", "minimum": 1, "maximum": 200},
    "scale_rung": {"type": "string", "enum": ["small", "30", "50", "100", "200", "200_plus_dry_run_planning"]},
    "event_name": {
      "type": "string",
      "enum": [
        "fault_planned",
        "fault_apply_started",
        "fault_apply_completed",
        "fault_effect_observed",
        "cluster_impact_started",
        "failover_started",
        "promotion_observed",
        "cluster_recovered",
        "workload_recovered",
        "fault_clear_started",
        "fault_clear_completed",
        "cleanup_verified"
      ]
    },
    "event_status": {"type": "string", "enum": ["OBSERVED", "MISSING", "SKIPPED_WITH_REASON", "BLOCKED_WITH_REASON", "FAIL"]},
    "timestamp_unix_ms": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "object", "required": ["status", "reason"]}
      ]
    },
    "monotonic_ms": {
      "oneOf": [
        {"type": "number", "minimum": 0},
        {"type": "object", "required": ["status", "reason"]}
      ]
    },
    "source": {"type": "string", "minLength": 1},
    "subject_type": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "real_valkey": {"type": "boolean"},
    "execution_mode": {"type": "string", "minLength": 1},
    "reason": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"event_status": {"enum": ["MISSING", "SKIPPED_WITH_REASON", "BLOCKED_WITH_REASON"]}},
        "required": ["event_status"]
      },
      "then": {
        "properties": {"reason": {"type": "string", "minLength": 1}}
      }
    }
  ],
  "additionalProperties": true
}
