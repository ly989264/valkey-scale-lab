{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loop Engineering Report Index",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "stage_id",
    "run_id",
    "created_at",
    "producer",
    "status",
    "source_of_truth",
    "source_artifacts",
    "reports"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "loop_report_index"},
    "stage_id": {"type": "string", "const": "L05_REPORTING_V2_FOR_AUDIT_RESULTS"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "source_of_truth": {"type": "boolean", "const": false},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "artifact_type", "status", "source_of_truth"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 64},
          "artifact_type": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "source_of_truth": {"type": "boolean", "const": true}
        },
        "additionalProperties": true
      }
    },
    "reports": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "role", "source_of_truth", "source_artifacts"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 64},
          "role": {"type": "string", "enum": ["html_report", "csv_view", "visualization", "json_index", "json_source"]},
          "source_of_truth": {"type": "boolean", "const": false},
          "source_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
