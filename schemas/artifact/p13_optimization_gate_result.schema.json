{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P13 Optimization Gate Result",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "created_at",
    "runner",
    "manifest_sha256",
    "status",
    "gates"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "p13_optimization_gate_result"},
    "phase_id": {"type": "string", "pattern": "^P13O-[0-9]{2}_[A-Z0-9_]+$"},
    "created_at": {"type": "string", "minLength": 1},
    "runner": {"type": "string", "const": "scripts/p13_optimization_gate.py"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "gates": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
