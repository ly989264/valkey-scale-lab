{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Committed Artifact Audit Report",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "created_at",
    "producer",
    "status",
    "audit_scope",
    "manifest_summary",
    "summary",
    "phase_results",
    "artifact_results",
    "gate_results",
    "p14_boundary",
    "findings"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "audit_report"},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL"]},
    "audit_scope": {
      "type": "object",
      "required": ["automatic_phase_ids", "optional_phase_ids", "required_artifact_count"],
      "properties": {
        "automatic_phase_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "optional_phase_ids": {"type": "array", "items": {"type": "string"}},
        "required_artifact_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "manifest_summary": {
      "type": "object",
      "required": ["default_max_nodes", "automatic_stop_after", "valkey_version_required_prefix"],
      "properties": {
        "default_max_nodes": {"type": "integer"},
        "automatic_stop_after": {"type": "string"},
        "valkey_version_required_prefix": {"type": "string"}
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "phase_count",
        "artifact_count",
        "gate_result_count",
        "blocking_findings_count",
        "historical_findings_count",
        "real_evidence_count"
      ],
      "properties": {
        "phase_count": {"type": "integer", "minimum": 0},
        "artifact_count": {"type": "integer", "minimum": 0},
        "gate_result_count": {"type": "integer", "minimum": 0},
        "blocking_findings_count": {"type": "integer", "minimum": 0},
        "historical_findings_count": {"type": "integer", "minimum": 0},
        "real_evidence_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "phase_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "phase_id",
          "automatic",
          "status",
          "required_artifacts_checked",
          "gate_result_checked",
          "real_evidence_checked",
          "blocking_findings",
          "historical_findings",
          "finding_ids"
        ],
        "properties": {
          "phase_id": {"type": "string", "minLength": 1},
          "automatic": {"type": "boolean"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED_WITH_REASON"]},
          "required_artifacts_checked": {"type": "integer", "minimum": 0},
          "gate_result_checked": {"type": "boolean"},
          "real_evidence_checked": {"type": "boolean"},
          "blocking_findings": {"type": "integer", "minimum": 0},
          "historical_findings": {"type": "integer", "minimum": 0},
          "finding_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "artifact_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase_id",
          "path",
          "required",
          "exists",
          "empty",
          "parse_mode",
          "json_valid",
          "schema_path",
          "schema_exists",
          "schema_valid",
          "sha256",
          "metadata",
          "finding_ids"
        ],
        "properties": {
          "phase_id": {"type": "string"},
          "path": {"type": "string"},
          "required": {"type": "boolean"},
          "exists": {"type": "boolean"},
          "empty": {"type": "boolean"},
          "parse_mode": {"type": "string", "enum": ["json", "jsonl", "missing", "invalid"]},
          "json_valid": {"type": "boolean"},
          "schema_path": {"type": "string"},
          "schema_exists": {"type": "boolean"},
          "schema_valid": {"type": "boolean"},
          "sha256": {"type": ["string", "null"]},
          "metadata": {"type": "object"},
          "finding_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase_id", "path", "exists", "schema_valid", "status", "finding_ids"],
        "properties": {
          "phase_id": {"type": "string"},
          "path": {"type": "string"},
          "exists": {"type": "boolean"},
          "schema_valid": {"type": "boolean"},
          "status": {"type": "string"},
          "finding_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "p14_boundary": {
      "type": "object",
      "required": [
        "phase_id",
        "automatic",
        "opt_in_required",
        "dry_run_only",
        "not_required_for_automatic_completion",
        "real_valkey_coverage",
        "real_evidence_count",
        "status",
        "reason"
      ],
      "properties": {
        "phase_id": {"type": "string", "const": "P14_SCALE_1000_OPTIN_DRYRUN"},
        "automatic": {"type": "boolean"},
        "opt_in_required": {"type": "boolean"},
        "dry_run_only": {"type": "boolean"},
        "not_required_for_automatic_completion": {"type": "boolean"},
        "real_valkey_coverage": {"type": "boolean"},
        "real_evidence_count": {"type": "integer", "minimum": 0},
        "status": {"type": "string", "enum": ["SKIPPED_WITH_REASON", "FAIL", "PASS"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "classification",
          "blocking",
          "description",
          "evidence"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "category": {"type": "string", "minLength": 1},
          "classification": {
            "type": "string",
            "enum": ["current", "historical", "dry_run_boundary", "informational"]
          },
          "blocking": {"type": "boolean"},
          "phase_id": {"type": "string"},
          "path": {"type": "string"},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
