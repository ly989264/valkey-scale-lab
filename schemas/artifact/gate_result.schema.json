{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate Result",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "created_at",
    "runner",
    "manifest_sha256",
    "status",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v1$"
    },
    "artifact_type": {
      "type": "string",
      "const": "gate_result"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "type": "string",
      "const": "scripts/codex_gate.py"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$|^replace-with-real-sha256$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "command",
          "required",
          "status",
          "exit_code",
          "started_at",
          "finished_at",
          "duration_seconds",
          "stdout_path",
          "stderr_path",
          "stdout_sha256",
          "stderr_sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED_WITH_REASON"
            ]
          },
          "exit_code": {
            "type": "integer"
          },
          "started_at": {
            "type": "string",
            "minLength": 1
          },
          "finished_at": {
            "type": "string",
            "minLength": 1
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "stdout_path": {
            "type": "string",
            "minLength": 1
          },
          "stderr_path": {
            "type": "string",
            "minLength": 1
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$|^replace-with-real-sha256$"
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$|^replace-with-real-sha256$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
