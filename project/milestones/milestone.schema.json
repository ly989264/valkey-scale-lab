{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valkey-scale-lab.local/milestones/milestone.schema.json",
  "title": "Valkey Scale Lab Product Milestone",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "goal", "criteria"],
  "properties": {
    "id": {"type": "string", "pattern": "^m[1-9][0-9]*$"},
    "goal": {"type": "string", "minLength": 1},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/criterion"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "statement": {"type": "string", "minLength": 1},
        "check": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/check"}
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "parameters": {"type": "object"}
      }
    }
  }
}
