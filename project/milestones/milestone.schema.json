{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valkey-scale-lab.local/milestones/milestone.schema.json",
  "title": "Valkey Scale Lab Product Milestone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone",
    "prerequisite_milestone_ids",
    "success_conditions",
    "evidence_gates"
  ],
  "properties": {
    "schema_version": {"const": "valkey-milestone-v1"},
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "goal"],
      "properties": {
        "id": {"type": "string", "pattern": "^m[1-9][0-9]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1}
      }
    },
    "prerequisite_milestone_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^m[1-9][0-9]*$"}
    },
    "success_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/successCondition"}
    },
    "evidence_gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceGate"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "suiteIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "successCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "suite_ids", "evidence_gate_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "statement": {"type": "string", "minLength": 1},
        "suite_ids": {"$ref": "#/$defs/suiteIds"},
        "evidence_gate_ids": {"$ref": "#/$defs/suiteIds"}
      }
    },
    "evidenceGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "suite_id",
        "parameters",
        "depends_on",
        "capture_class",
        "operator_approval_required"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "suite_id": {"$ref": "#/$defs/identifier"},
        "parameters": {"type": "object"},
        "depends_on": {"$ref": "#/$defs/suiteIds"},
        "capture_class": {"const": "REAL"},
        "operator_approval_required": {"const": true}
      }
    }
  }
}
