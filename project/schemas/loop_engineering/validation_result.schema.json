{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loop Engineering Validation Result",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "status",
    "completed_at",
    "commands_log",
    "commands",
    "current_harness_passed",
    "previous_harness_passed"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "stage_id": {"type": "string", "pattern": "^L[0-9]{2}_[A-Z0-9_]+$"},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
    "completed_at": {"type": "string", "minLength": 1},
    "commands_log": {"type": "string", "minLength": 1},
    "commands": {"type": "array", "items": {"type": "object"}},
    "current_harness_passed": {"type": "boolean"},
    "previous_harness_passed": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
