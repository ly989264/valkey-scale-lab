{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loop Engineering Current Harness Plan",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "new_tests",
    "new_schemas",
    "new_cli_gates",
    "new_artifact_checks",
    "expected_initial_failures",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "stage_id": {"type": "string", "pattern": "^L[0-9]{2}_[A-Z0-9_]+$"},
    "new_tests": {"type": "array", "items": {"type": "object"}},
    "new_schemas": {"type": "array", "items": {"type": "string"}},
    "new_cli_gates": {"type": "array", "items": {"type": "object"}},
    "new_artifact_checks": {"type": "array", "items": {"type": "string"}},
    "expected_initial_failures": {"type": "array", "items": {"type": "object"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
