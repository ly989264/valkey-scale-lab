{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command Audit Summary",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "capability_id",
    "run_id",
    "status",
    "command_log_ref",
    "total_commands",
    "pass_count",
    "failure_count",
    "timeout_count",
    "retry_count",
    "slowest_commands_topN",
    "failed_commands",
    "retry_commands",
    "operation_traceability",
    "coverage",
    "missing_or_skipped"
  ],
  "properties": {
    "schema_version": {"const": "v1"},
    "artifact_type": {"const": "command_audit_summary"},
    "capability_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string"},
    "status": {"enum": ["PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON", "BLOCKED_WITH_REASON"]},
    "command_log_ref": {"type": "string", "minLength": 1},
    "total_commands": {"type": "integer", "minimum": 0},
    "pass_count": {"type": "integer", "minimum": 0},
    "failure_count": {"type": "integer", "minimum": 0},
    "timeout_count": {"type": "integer", "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0},
    "by_command_kind": {"type": "object"},
    "slowest_commands_topN": {"type": "array"},
    "failed_commands": {"type": "array"},
    "timeout_commands": {"type": "array"},
    "retry_commands": {"type": "array"},
    "operation_traceability": {"type": "array"},
    "coverage": {"type": "object"},
    "missing_or_skipped": {"type": "array"}
  },
  "additionalProperties": true
}
