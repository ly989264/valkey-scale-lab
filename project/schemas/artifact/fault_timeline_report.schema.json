{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fault Timeline Report",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "status",
    "required_fault_types",
    "observed_fault_types",
    "required_scale_rungs",
    "observed_scale_rungs",
    "timeline_events_ref",
    "failover_latency_samples_ref",
    "fault_workload_impact_ref",
    "fault_rows",
    "missing_metrics"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "fault_timeline_report"},
    "phase_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED_WITH_REASON"]},
    "required_fault_types": {"type": "array", "minItems": 12, "items": {"type": "string"}},
    "observed_fault_types": {"type": "array", "items": {"type": "string"}},
    "required_scale_rungs": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "observed_scale_rungs": {"type": "array", "items": {"type": "string"}},
    "timeline_events_ref": {"type": "string", "minLength": 1},
    "failover_latency_samples_ref": {"type": "string", "minLength": 1},
    "fault_workload_impact_ref": {"type": "string", "minLength": 1},
    "fault_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sample_id",
          "fault_id",
          "fault_type",
          "node_count",
          "scale_rung",
          "execution_mode",
          "timeline_status",
          "timeline_event_refs",
          "metrics",
          "metric_sources",
          "workload_window_refs",
          "cleanup_ref",
          "valkey_e2e_evidence_ref",
          "clean_cluster_evidence"
        ],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "fault_id": {"type": "string", "minLength": 1},
          "fault_type": {"type": "string", "minLength": 1},
          "node_count": {"type": "integer", "minimum": 1, "maximum": 200},
          "scale_rung": {"type": "string", "enum": ["small", "30", "50", "100", "200", "200_plus_dry_run_planning"]},
          "execution_mode": {"type": "string", "minLength": 1},
          "real_valkey": {"type": "boolean"},
          "timeline_status": {"type": "string", "enum": ["PASS", "PARTIAL", "MISSING", "SKIPPED_WITH_REASON", "BLOCKED_WITH_REASON", "FAIL"]},
          "timeline_event_refs": {"type": "array", "minItems": 12, "items": {"type": "string"}},
          "metrics": {
            "type": "object",
            "required": [
              "apply_duration_ms",
              "effect_observed_delay_ms",
              "cluster_impact_ms",
              "failover_latency_ms",
              "promotion_latency_ms",
              "client_unavailability_ms",
              "workload_recovery_ms",
              "clear_duration_ms",
              "cleanup_duration_ms",
              "split_brain_window_ms",
              "cluster_down_window_ms"
            ]
          },
          "metric_sources": {"type": "object"},
          "workload_window_refs": {"type": "array", "items": {"type": "string"}},
          "cleanup_ref": {"type": "string", "minLength": 1},
          "valkey_e2e_evidence_ref": {"type": "string", "minLength": 1},
          "clean_cluster_evidence": {"type": "object", "required": ["status", "ref"]}
        },
        "additionalProperties": true
      }
    },
    "missing_metrics": {"type": "array", "items": {"type": "object"}},
    "latency_distribution": {"type": "object"},
    "split_brain_window_distribution": {"type": "object"}
  },
  "additionalProperties": true
}
