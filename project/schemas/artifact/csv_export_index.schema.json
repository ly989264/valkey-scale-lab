{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Loop CSV Export Index",
  "type": "object",
  "required": ["schema_version", "artifact_type", "phase_id", "run_id", "json_source_artifact", "exports"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "csv_export_index"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "json_source_artifact": {"type": "string", "minLength": 1},
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["table_name", "path", "row_count", "json_source_count", "json_source_artifact", "sha256"],
        "properties": {
          "table_name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "row_count": {"type": "integer", "minimum": 0},
          "json_source_count": {"type": "integer", "minimum": 0},
          "json_source_artifact": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
