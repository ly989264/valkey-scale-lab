{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Loop Final Report Index",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "capability_id",
    "run_id",
    "created_at",
    "producer",
    "status",
    "generator_version",
    "derivation_policy",
    "reports",
    "exports",
    "csv_export_index_ref",
    "source_artifacts",
    "coverage_summary"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "final_report_index"},
    "capability_id": {"type": "string", "const": "final_report"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "const": "PASS"},
    "generator_version": {"type": "string", "minLength": 1},
    "derivation_policy": {
      "type": "object",
      "required": ["artifact_only", "log_parsing", "rendered_views_as_metric_sources", "source_scenarios_rerun"],
      "properties": {
        "artifact_only": {"type": "boolean", "const": true},
        "allowed_metric_source_extensions": {
          "type": "array",
          "contains": {"type": "string", "const": ".json"}
        },
        "log_parsing": {"type": "boolean", "const": false},
        "rendered_views_as_metric_sources": {"type": "boolean", "const": false},
        "source_scenarios_rerun": {"type": "boolean", "const": false}
      },
      "additionalProperties": true
    },
    "reports": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^artifacts/captures/final_report/reports/.+\\.md$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "exports": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "table_name"],
        "properties": {
          "path": {"type": "string", "pattern": "^artifacts/captures/final_report/exports/.+\\.csv$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "table_name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "csv_export_index_ref": {"type": "string", "pattern": "^artifacts/captures/final_report/csv_export_index\\.json$"},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "path", "artifact_type", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^artifacts/captures/.+\\.(json|jsonl)$"},
          "artifact_type": {"type": "string", "enum": ["json", "jsonl"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "coverage_summary": {
      "type": "object",
      "required": ["management", "failover", "fault", "workload", "missing_data", "cleanup", "safety"],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
