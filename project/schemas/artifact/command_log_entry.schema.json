{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime Command Log Entry",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "capability_id",
    "run_id",
    "scenario",
    "operation_id",
    "step_id",
    "command_id",
    "command_kind",
    "host_id",
    "node_logical_id",
    "client_port",
    "argv",
    "started_at_unix_ms",
    "ended_at_unix_ms",
    "duration_ms",
    "exit_code",
    "stdout_path",
    "stdout_sha256",
    "stderr_path",
    "stderr_sha256",
    "retry_index",
    "timeout_ms",
    "status",
    "error_type",
    "host_network_mutated",
    "global_firewall_mutated"
  ],
  "properties": {
    "schema_version": {"const": "v1"},
    "artifact_type": {"const": "runtime_command_log_entry"},
    "capability_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "command_id": {"type": "string", "pattern": "^cmd-[0-9]{6}$"},
    "command_kind": {"type": "string", "minLength": 1},
    "command_scope": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "node_logical_id": {"type": "string", "minLength": 1},
    "nodehost_id": {"type": "string", "minLength": 1},
    "container_name": {"type": "string", "minLength": 1},
    "client_port": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 65535},
        {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": {"enum": ["MISSING", "SKIPPED_WITH_REASON"]},
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        }
      ]
    },
    "argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "started_at_unix_ms": {"type": "integer", "minimum": 0},
    "ended_at_unix_ms": {"type": "integer", "minimum": 0},
    "duration_ms": {"type": "number", "minimum": 0},
    "exit_code": {
      "oneOf": [
        {"type": "integer"},
        {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": {"enum": ["MISSING", "SKIPPED_WITH_REASON"]},
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        }
      ]
    },
    "stdout_path": {"type": "string", "minLength": 1},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_path": {"type": "string", "minLength": 1},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retry_index": {"type": "integer", "minimum": 0},
    "attempt_count": {"type": "integer", "minimum": 1},
    "timeout_ms": {"type": "integer", "minimum": 0},
    "status": {"enum": ["PASS", "FAIL", "TIMEOUT", "RETRY", "SKIPPED_WITH_REASON", "MISSING"]},
    "error_type": {"type": "string"},
    "redaction": {"type": "object"},
    "trace_refs": {"type": "array", "items": {"type": "string"}},
    "host_network_mutated": {"const": false},
    "global_firewall_mutated": {"const": false}
  },
  "additionalProperties": true
}
