{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Valkey Scenario Metric Sample",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "phase_id",
    "scenario_name",
    "sample_id",
    "timestamp_unix_ms",
    "monotonic_ms",
    "source_type",
    "source_id",
    "metric_name",
    "metric_value",
    "metric_unit",
    "labels",
    "missing_reason"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "run_id": {"type": "string", "minLength": 1},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "scenario_name": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "timestamp_unix_ms": {"type": ["integer", "string"]},
    "monotonic_ms": {"type": ["number", "string"]},
    "source_type": {"type": "string", "enum": ["valkey_info", "cluster_info", "cluster_nodes", "docker_stats", "workload", "harness", "system_process", "system_network"]},
    "source_id": {"type": "string", "minLength": 1},
    "metric_name": {"type": "string", "minLength": 1},
    "metric_value": {"type": ["number", "string", "boolean"]},
    "metric_unit": {"type": "string"},
    "labels": {"type": "object"},
    "missing_reason": {"type": "string"}
  },
  "additionalProperties": true
}
