{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workload_window_report",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "capability_id",
    "run_id",
    "created_at",
    "producer",
    "status",
    "node_count",
    "scenario",
    "windows"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "workload_window_report"},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "MISSING", "SKIPPED_WITH_REASON"]},
    "node_count": {"type": "integer", "enum": [30, 50, 100]},
    "scenario": {"type": "string", "minLength": 1},
    "windows": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "operation_count",
          "availability_percent",
          "errors_total",
          "timeouts_total",
          "latency_ms"
        ],
        "properties": {
          "name": {"type": "string", "enum": ["before_fault", "during_fault", "after_recovery"]},
          "status": {"type": "string", "enum": ["MEASURED", "MISSING", "SKIPPED_WITH_REASON"]},
          "operation_count": {"type": "integer", "minimum": 0},
          "availability_percent": {"type": "number", "minimum": 0, "maximum": 100},
          "errors_total": {"type": "integer", "minimum": 0},
          "timeouts_total": {"type": "integer", "minimum": 0},
          "latency_ms": {
            "type": "object",
            "required": ["p50", "p95", "p99"],
            "properties": {
              "p50": {"type": "number", "minimum": 0},
              "p95": {"type": "number", "minimum": 0},
              "p99": {"type": "number", "minimum": 0}
            },
            "additionalProperties": true
          },
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "missing_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "status", "reason"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["MISSING", "SKIPPED_WITH_REASON"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
