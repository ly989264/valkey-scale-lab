{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analysis_summary",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "created_at",
    "producer",
    "status",
    "run_manifest_ref",
    "run_metadata_ref",
    "run_metadata",
    "findings",
    "missing_metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v1$"
    },
    "artifact_type": {
      "type": "string",
      "const": "analysis_summary"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "MISSING",
        "SKIPPED_WITH_REASON",
        "NO_BASELINE_YET"
      ]
    },
    "run_manifest_ref": {
      "$ref": "#/$defs/artifact_ref_or_reason"
    },
    "run_metadata_ref": {
      "$ref": "#/$defs/artifact_ref_or_reason"
    },
    "run_metadata": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "artifact_type",
            "run_id"
          ],
          "properties": {
            "artifact_type": {
              "type": "string",
              "const": "run_metadata"
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        {
          "$ref": "#/$defs/reason"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "missing_metrics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "artifact_ref_or_reason": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            }
          },
          "additionalProperties": true
        },
        {
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "MISSING",
                "SKIPPED_WITH_REASON"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "reason": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "MISSING",
            "SKIPPED_WITH_REASON"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
