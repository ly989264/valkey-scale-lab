{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failover Observer Sample",
  "type": "object",
  "required": [
    "schema_version",
    "phase_id",
    "run_id",
    "scenario_name",
    "sample_id",
    "timestamp_unix_ms",
    "monotonic_ms",
    "node_count",
    "status",
    "cluster_state",
    "cluster_slots_assigned",
    "cluster_slots_ok",
    "pfail_count",
    "fail_count",
    "handshake_count",
    "target_reachable",
    "expected_replica_promoted",
    "observed_node_count",
    "probe_status_counts"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_name": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "timestamp_unix_ms": {"type": "integer"},
    "monotonic_ms": {"type": ["number", "integer"]},
    "node_count": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "cluster_state": {"type": "string", "minLength": 1},
    "cluster_slots_assigned": {"type": "integer", "minimum": 0, "maximum": 16384},
    "cluster_slots_ok": {"type": "integer", "minimum": 0, "maximum": 16384},
    "pfail_count": {"type": "integer", "minimum": 0},
    "fail_count": {"type": "integer", "minimum": 0},
    "handshake_count": {"type": "integer", "minimum": 0},
    "target_reachable": {"type": "boolean"},
    "expected_replica_promoted": {"type": "boolean"},
    "observed_node_count": {"type": "integer", "minimum": 0},
    "probe_status_counts": {"type": "object"}
  },
  "additionalProperties": true
}
