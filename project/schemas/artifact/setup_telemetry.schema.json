{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "setup_telemetry",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "scenario",
    "created_at",
    "producer",
    "status",
    "node_count",
    "same_schema_scale_rungs",
    "metrics",
    "per_node_samples",
    "per_nodehost_samples",
    "slowest_nodes_topN",
    "slowest_replica_replicate_topN",
    "cleanup",
    "missing_metrics",
    "source_artifacts"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "setup_telemetry"},
    "phase_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {"type": "object"},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "MISSING", "SKIPPED_WITH_REASON", "BLOCKED_WITH_REASON"]},
    "node_count": {"type": "integer", "minimum": 0},
    "same_schema_scale_rungs": {
      "type": "array",
      "allOf": [
        {"contains": {"const": 30}},
        {"contains": {"const": 50}},
        {"contains": {"const": 100}},
        {"contains": {"const": 200}}
      ],
      "items": {"type": "integer"}
    },
    "metrics": {
      "type": "object",
      "required": [
        "config_parse_ms",
        "config_validate_ms",
        "resource_preflight_ms",
        "plan_build_ms",
        "port_check_ms",
        "nodehost_start_ms",
        "node_config_generate_ms",
        "node_config_distribute_ms",
        "process_start_ms",
        "process_ready_wait_ms",
        "cluster_meet_ms",
        "cluster_slots_assign_ms",
        "replica_replicate_ms",
        "cluster_convergence_probe_ms",
        "full_cluster_probe_ms",
        "cleanup_ms",
        "total_setup_ms"
      ],
      "additionalProperties": {"$ref": "#/$defs/metric_value"}
    },
    "per_node_samples": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "per_nodehost_samples": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "slowest_nodes_topN": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "slowest_replica_replicate_topN": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "cleanup": {"type": "object"},
    "missing_metrics": {"type": "array", "items": {"type": "object"}},
    "source_artifacts": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "metric_value": {
      "oneOf": [
        {"type": "number", "minimum": 0},
        {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": {"type": "string", "enum": ["MISSING", "SKIPPED_WITH_REASON"]},
            "reason": {"type": "string", "minLength": 1},
            "impact": {"type": "string"}
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
