{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Loop Topology Snapshot",
  "type": "object",
  "required": ["schema_version", "phase_id", "run_id", "snapshot_id", "timestamp_unix_ms", "nodes", "slots"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "timestamp_unix_ms": {"type": ["integer", "string"]},
    "nodes": {"type": "array"},
    "slots": {"type": "object"}
  },
  "additionalProperties": true
}
