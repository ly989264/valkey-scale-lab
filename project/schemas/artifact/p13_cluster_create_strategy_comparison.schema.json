{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P13 Cluster Create Strategy Comparison",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "created_at",
    "producer",
    "status",
    "default_strategy",
    "selected_default_safe",
    "strategies"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "p13_cluster_create_strategy_comparison"},
    "phase_id": {"type": "string", "const": "P13O-01_CLUSTER_CREATE_AB"},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {"type": "object"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "default_strategy": {"type": "string", "const": "valkey_cli_cluster_create_primaries"},
    "selected_default_safe": {"type": "boolean"},
    "strategies": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "strategy",
          "status",
          "default",
          "experimental",
          "observations"
        ],
        "properties": {
          "strategy": {"type": "string"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED_WITH_REASON"]},
          "default": {"type": "boolean"},
          "experimental": {"type": "boolean"},
          "observations": {"type": "array", "minItems": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
