{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strict Harness Extension Report",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "created_at",
    "status",
    "no_real_runtime_claimed",
    "lock_update_reason",
    "harness_changes",
    "assertion_scripts",
    "coverage_ids",
    "runtime_claims"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "harness_extension_report"},
    "phase_id": {"type": "string", "const": "P27_STRICT_MATRIX_REBASE_HARNESS"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "no_real_runtime_claimed": {"type": "boolean", "const": true},
    "lock_update_reason": {"type": "string", "minLength": 1},
    "harness_changes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "assertion_scripts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "coverage_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "runtime_claims": {
      "type": "object",
      "required": ["real_valkey_claimed", "management_runtime_claimed", "fault_runtime_claimed"],
      "properties": {
        "real_valkey_claimed": {"type": "boolean", "const": false},
        "management_runtime_claimed": {"type": "boolean", "const": false},
        "fault_runtime_claimed": {"type": "boolean", "const": false}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
