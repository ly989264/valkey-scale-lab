{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Decision",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "capability_id",
    "decision",
    "fresh_context",
    "auditor",
    "created_at",
    "gate_result_path",
    "gate_result_sha256",
    "artifact_paths",
    "risks",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v1$"
    },
    "artifact_type": {
      "type": "string",
      "const": "audit_decision"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "fresh_context": {
      "type": "boolean"
    },
    "auditor": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "gate_result_path": {
      "type": "string",
      "minLength": 1
    },
    "gate_result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$|^replace-with-real-sha256$"
    },
    "artifact_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "risk",
          "severity",
          "required_before_next_capability"
        ],
        "properties": {
          "risk": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "required_before_next_capability": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
