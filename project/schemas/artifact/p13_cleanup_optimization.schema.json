{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P13 Cleanup Optimization",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "created_at",
    "producer",
    "status",
    "safety_constraints",
    "observations",
    "errors"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "p13_cleanup_optimization"},
    "phase_id": {"type": "string", "const": "P13O-03_CLEANUP_OPTIMIZATION"},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {"type": "object"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "safety_constraints": {
      "type": "object",
      "required": [
        "bounded_parallelism",
        "cleanup_failure_ignored",
        "host_network_mutation",
        "p14_executed",
        "default_max_nodes"
      ],
      "properties": {
        "bounded_parallelism": {"type": "boolean", "const": true},
        "cleanup_failure_ignored": {"type": "boolean", "const": false},
        "host_network_mutation": {"type": "boolean", "const": false},
        "p14_executed": {"type": "boolean", "const": false},
        "default_max_nodes": {"type": "integer", "maximum": 100}
      },
      "additionalProperties": true
    },
    "observations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "scenario",
          "node_count",
          "status",
          "real_valkey",
          "evidence_path",
          "cleanup_report_path",
          "cleanup_timing",
          "resources_remaining_count",
          "cleanup_action_counts"
        ],
        "properties": {
          "scenario": {"type": "string", "enum": ["scale_50", "scale_100"]},
          "node_count": {"type": "integer", "minimum": 1, "maximum": 100},
          "status": {"type": "string", "enum": ["PASS", "FAIL"]},
          "real_valkey": {"type": ["boolean", "string"]},
          "evidence_path": {"type": "string", "minLength": 1},
          "cleanup_report_path": {"type": "string", "minLength": 1},
          "cleanup_timing": {
            "type": "object",
            "required": [
              "cleanup_terminate_processes_seconds",
              "cleanup_verify_process_exit_seconds",
              "cleanup_verify_nodehost_empty_seconds",
              "cleanup_remove_containers_seconds",
              "cleanup_remove_networks_seconds",
              "cleanup_residual_scan_seconds"
            ],
            "properties": {
              "cleanup_terminate_processes_seconds": {"type": "number", "minimum": 0},
              "cleanup_verify_process_exit_seconds": {"type": "number", "minimum": 0},
              "cleanup_verify_nodehost_empty_seconds": {"type": "number", "minimum": 0},
              "cleanup_remove_containers_seconds": {"type": "number", "minimum": 0},
              "cleanup_remove_networks_seconds": {"type": "number", "minimum": 0},
              "cleanup_residual_scan_seconds": {"type": "number", "minimum": 0},
              "bounded_parallelism": {"type": "boolean", "const": true}
            },
            "additionalProperties": true
          },
          "resources_remaining_count": {"type": "integer", "const": 0},
          "cleanup_action_counts": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "errors": {"type": "array"}
  },
  "additionalProperties": true
}
