                        "p95": {"type": ["number", "object"], "required": ["status", "reason"], "properties": {"status": {"type": "string", "enum": ["MISSING", "SKIPPED_WITH_REASON"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": true},
                        "p99": {"type": ["number", "object"], "required": ["status", "reason"], "properties": {"status": {"type": "string", "enum": ["MISSING", "SKIPPED_WITH_REASON"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": true}
