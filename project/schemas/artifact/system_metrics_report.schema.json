{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M1 System Metrics Report",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "scenario_name",
    "status",
    "node_count",
    "sample_count",
    "lifecycle_windows",
    "coverage",
    "missing_metric_count",
    "missing_metrics",
    "source_refs"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "system_metrics_report"},
    "phase_id": {"type": "string", "minLength": 1},
    "stage_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_name": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED_WITH_REASON", "SKIPPED_WITH_REASON"]},
    "node_count": {"type": "integer", "minimum": 0},
    "scale": {"type": "integer", "minimum": 0},
    "sample_count": {"type": "integer", "minimum": 0},
    "lifecycle_windows": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "coverage": {
      "type": "object",
      "required": ["required_metrics", "observed_metrics", "missing_required_metrics", "rows_by_window", "rows_by_node"],
      "properties": {
        "required_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "observed_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "missing_required_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rows_by_window": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "rows_by_node": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": true
    },
    "missing_metric_count": {"type": "integer", "minimum": 0},
    "missing_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "metric", "status", "reason", "window"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "metric": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_REASON"]},
          "reason": {"type": "string", "minLength": 1},
          "window": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "sample_errors": {"type": "array"},
    "source_refs": {"type": "object"}
  },
  "additionalProperties": true
}
