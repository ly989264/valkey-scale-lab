{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Loop Slot Movement",
  "type": "object",
  "required": ["schema_version", "phase_id", "run_id", "movement_id", "source_node_id", "target_node_id", "slot_start", "slot_end", "status"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "movement_id": {"type": "string", "minLength": 1},
    "source_node_id": {"type": "string", "minLength": 1},
    "target_node_id": {"type": "string", "minLength": 1},
    "slot_start": {"type": "integer", "minimum": 0, "maximum": 16383},
    "slot_end": {"type": "integer", "minimum": 0, "maximum": 16383},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_REASON"]}
  },
  "additionalProperties": true
}
