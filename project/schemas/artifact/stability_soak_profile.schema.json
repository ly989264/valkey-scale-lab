{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stability Soak Profile",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "created_at",
    "producer",
    "status",
    "node_count",
    "evidence_layer",
    "evidence_class",
    "real_valkey_coverage",
    "resource_aware",
    "bounded",
    "long_run_stability_claim",
    "windows",
    "metric_records",
    "source_hashes",
    "source_artifacts"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "stability_soak_profile"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED_WITH_REASON", "BLOCKED"]},
    "reason": {"type": "string"},
    "node_count": {"type": "integer", "minimum": 1, "maximum": 100},
    "evidence_layer": {"type": "string", "enum": ["small-real", "30", "50", "100"]},
    "evidence_class": {"type": "string", "enum": ["real_valkey", "resource_aware_profile"]},
    "real_valkey_coverage": {"type": "boolean"},
    "resource_aware": {"type": "boolean"},
    "bounded": {"type": "boolean"},
    "long_run_stability_claim": {"type": "boolean", "const": false},
    "metrics_timeseries_path": {"type": "string"},
    "baseline_comparison_path": {"type": "string"},
    "windows": {
      "type": "object",
      "required": ["baseline", "steady", "fault", "recovery", "post_recovery"],
      "properties": {
        "baseline": {"type": "object"},
        "steady": {"type": "object"},
        "fault": {"type": "object"},
        "recovery": {"type": "object"},
        "post_recovery": {"type": "object"}
      },
      "additionalProperties": true
    },
    "metric_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "surface", "unit", "status", "source_artifact", "source_pointer", "evidence_layer"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "surface": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["MEASURED", "MISSING", "SKIPPED_WITH_REASON", "NO_BASELINE_YET"]},
          "reason": {"type": "string"},
          "source_artifact": {"type": "string", "minLength": 1},
          "source_pointer": {"type": "string", "minLength": 1},
          "evidence_layer": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "exists": {"type": "boolean"},
          "sha256": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
