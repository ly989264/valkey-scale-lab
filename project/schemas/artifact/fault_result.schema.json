{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fault Result",
  "type": "object",
  "required": [
    "schema_version",
    "capability_id",
    "fault_type",
    "fault_id",
    "scope",
    "implementation_path",
    "targets",
    "apply_started_at_ms",
    "apply_completed_at_ms",
    "clear_started_at_ms",
    "clear_completed_at_ms",
    "recovery_completed_at_ms",
    "safety_scope_verified",
    "cleanup_verified",
    "workload_impact_ref"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "fault_type": {"type": "string", "minLength": 1},
    "fault_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "implementation_path": {"type": "string", "enum": ["container_netns_tc", "sandbox_proxy", "owned_container_control", "owned_runtime_control", "owned_docker_network_control", "unsupported_skipped_with_reason"]},
    "targets": {"type": "array"},
    "apply_started_at_ms": {"type": ["integer", "string"]},
    "apply_completed_at_ms": {"type": ["integer", "string"]},
    "clear_started_at_ms": {"type": ["integer", "string"]},
    "clear_completed_at_ms": {"type": ["integer", "string"]},
    "recovery_completed_at_ms": {"type": ["integer", "string"]},
    "safety_scope_verified": {"type": "boolean"},
    "cleanup_verified": {"type": "boolean"},
    "workload_impact_ref": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
