{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valkey-scale-lab.local/schemas/evidence_provenance.schema.json",
  "title": "Valkey Scale Lab evidence provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "definition_digest", "capture_nodes", "admission_nodes", "provenance_digest"],
  "properties": {
    "schema_version": {"const": "valkey-scale-lab-evidence-provenance-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "definition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capture_nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/captureNode"}},
    "admission_nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/admissionNode"}}
  },
  "$defs": {
    "captureNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^runtime/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "admissionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256", "source_path", "source_sha256", "transform_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^runtime/admission_v2/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_path": {"type": "string", "pattern": "^runtime/"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "transform_id": {"type": ["string", "null"]}
      }
    }
  }
}
