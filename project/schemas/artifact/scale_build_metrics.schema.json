{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scale Build Metrics Audit",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "created_at",
    "producer",
    "status",
    "summary",
    "canonical_rungs",
    "p14_boundary",
    "findings"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "scale_build_metrics"},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "PARTIAL"]},
    "summary": {
      "type": "object",
      "required": [
        "blocking_findings_count",
        "rung_count",
        "canonical_node_counts",
        "measured_metric_count",
        "missing_metric_count",
        "skipped_metric_count",
        "real_valkey_rung_count",
        "cleanup_pass_count",
        "p14_dry_run_only"
      ],
      "properties": {
        "blocking_findings_count": {"type": "integer", "minimum": 0},
        "rung_count": {"type": "integer", "const": 3},
        "canonical_node_counts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "integer", "enum": [30, 50, 100]}
        },
        "measured_metric_count": {"type": "integer", "minimum": 1},
        "missing_metric_count": {"type": "integer", "minimum": 0},
        "skipped_metric_count": {"type": "integer", "minimum": 0},
        "real_valkey_rung_count": {"type": "integer", "const": 3},
        "cleanup_pass_count": {"type": "integer", "const": 3},
        "p14_dry_run_only": {"type": "boolean", "const": true}
      },
      "additionalProperties": true
    },
    "canonical_rungs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "node_count",
          "scenario",
          "phase_id",
          "status",
          "evidence_path",
          "source_artifacts",
          "real_valkey",
          "nodes_observed",
          "cluster_state_observed",
          "probe_result",
          "data_path_result",
          "valkey_versions",
          "metric_records",
          "findings"
        ],
        "properties": {
          "node_count": {"type": "integer", "enum": [30, 50, 100]},
          "scenario": {"type": "string", "minLength": 1},
          "phase_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "PARTIAL"]},
          "evidence_path": {"type": "string", "minLength": 1},
          "source_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["role", "path", "exists", "sha256"],
              "properties": {
                "role": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1},
                "exists": {"type": "boolean"},
                "sha256": {"type": ["string", "null"]},
                "artifact_type": {"type": ["string", "null"]},
                "status": {"type": ["string", "null"]}
              },
              "additionalProperties": true
            }
          },
          "real_valkey": {"type": "boolean", "const": true},
          "nodes_observed": {"type": "integer", "enum": [30, 50, 100]},
          "cluster_state_observed": {"type": "string", "const": "ok"},
          "probe_result": {"type": "string", "const": "PASS"},
          "data_path_result": {"type": "string", "const": "PASS"},
          "valkey_versions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^9\\.1\\."}
          },
          "metric_records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "status",
                "required",
                "source_artifact",
                "source_role",
                "reason"
              ],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "status": {"type": "string", "enum": ["MEASURED", "MISSING", "SKIPPED_WITH_REASON", "NO_BASELINE_YET"]},
                "required": {"type": "boolean"},
                "value": {"type": ["number", "integer", "string", "boolean", "object", "array", "null"]},
                "unit": {"type": ["string", "null"]},
                "source_artifact": {"type": "string", "minLength": 1},
                "source_role": {"type": "string", "minLength": 1},
                "reason": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "findings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "p14_boundary": {
      "type": "object",
      "required": [
        "phase_id",
        "status",
        "dry_run_only",
        "real_valkey_coverage",
        "real_evidence_count",
        "reason"
      ],
      "properties": {
        "phase_id": {"type": "string", "const": "P14_SCALE_1000_OPTIN_DRYRUN"},
        "status": {"type": "string", "const": "SKIPPED_WITH_REASON"},
        "dry_run_only": {"type": "boolean", "const": true},
        "real_valkey_coverage": {"type": "boolean", "const": false},
        "real_evidence_count": {"type": "integer", "const": 0},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "classification", "blocking", "description", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "category": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "enum": ["current", "historical", "informational"]},
          "blocking": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
