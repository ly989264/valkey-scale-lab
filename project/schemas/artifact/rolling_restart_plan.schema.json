{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Loop Rolling Restart Plan",
  "type": "object",
  "required": ["schema_version", "artifact_type", "phase_id", "run_id", "restart_order", "health_gate", "operations"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "rolling_restart_plan"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "restart_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation_id", "sequence", "logical_node_id", "planned_role", "shard_id"],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 1},
          "logical_node_id": {"type": "string", "minLength": 1},
          "planned_role": {"type": "string", "enum": ["primary", "replica"]},
          "shard_id": {"type": "string", "minLength": 1},
          "container_name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "health_gate": {
      "type": "object",
      "required": ["required_between_nodes", "required_after_each_restart", "cluster_state", "slots_assigned", "max_concurrent_restarts"],
      "properties": {
        "required_between_nodes": {"type": "boolean", "const": true},
        "required_after_each_restart": {"type": "boolean", "const": true},
        "cluster_state": {"type": "string", "const": "ok"},
        "slots_assigned": {"type": "integer", "const": 16384},
        "max_concurrent_restarts": {"type": "integer", "const": 1}
      },
      "additionalProperties": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation_id", "operation_name", "node_count", "max_concurrent_restarts", "health_gate", "restart_order"],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "operation_name": {"type": "string", "enum": ["rolling_restart_replica_first", "rolling_restart_primary_safe"]},
          "node_count": {"type": "integer", "enum": [6, 10]},
          "max_concurrent_restarts": {"type": "integer", "const": 1},
          "health_gate": {"type": "object"},
          "restart_order": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sequence", "logical_node_id", "planned_role", "shard_id"],
              "properties": {
                "sequence": {"type": "integer", "minimum": 1},
                "logical_node_id": {"type": "string", "minLength": 1},
                "planned_role": {"type": "string", "enum": ["primary", "replica"]},
                "shard_id": {"type": "string", "minLength": 1},
                "container_name": {"type": "string", "minLength": 1}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
