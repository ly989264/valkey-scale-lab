{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coverage Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "created_at",
    "producer",
    "status",
    "summary",
    "layers",
    "surfaces",
    "entries",
    "scale_planning_boundary",
    "findings"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "coverage_matrix"},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL"]},
    "summary": {
      "type": "object",
      "required": [
        "entry_count",
        "covered_entry_count",
        "real_coverage_entry_count",
        "dry_run_entry_count",
        "blocking_findings_count"
      ],
      "properties": {
        "entry_count": {"type": "integer", "minimum": 1},
        "covered_entry_count": {"type": "integer", "minimum": 0},
        "real_coverage_entry_count": {"type": "integer", "minimum": 0},
        "dry_run_entry_count": {"type": "integer", "minimum": 0},
        "blocking_findings_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "layers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["fake", "small-real", "30", "50", "100", "200", "1000-dry-run"]}
    },
    "surfaces": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["cluster_build", "management", "workload", "observability", "fault", "failover", "stability", "cleanup", "scale", "report_visualization"]}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "layer",
          "surface",
          "status",
          "evidence_class",
          "metric_count",
          "metric_names",
          "source_artifacts",
          "node_count_scope",
          "real_valkey_coverage",
          "dry_run_only",
          "reason"
        ],
        "properties": {
          "layer": {"type": "string", "enum": ["fake", "small-real", "30", "50", "100", "200", "1000-dry-run"]},
          "surface": {"type": "string", "enum": ["cluster_build", "management", "workload", "observability", "fault", "failover", "stability", "cleanup", "scale", "report_visualization"]},
          "status": {"type": "string", "enum": ["COVERED", "MISSING", "SKIPPED_WITH_REASON"]},
          "evidence_class": {"type": "string", "enum": ["fake", "real_valkey", "dry_run_planner", "source_artifact", "report_view", "none"]},
          "metric_count": {"type": "integer", "minimum": 0},
          "metric_names": {"type": "array", "items": {"type": "string"}},
          "source_artifacts": {"type": "array", "items": {"type": "string"}},
          "node_count_scope": {"type": "string", "minLength": 1},
          "real_valkey_coverage": {"type": "boolean"},
          "dry_run_only": {"type": "boolean"},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "scale_planning_boundary": {
      "type": "object",
      "required": ["capability_id", "status", "real_valkey_coverage", "reason"],
      "properties": {
        "capability_id": {"type": "string"},
        "status": {"type": "string", "enum": ["SKIPPED_WITH_REASON", "PASS", "FAIL"]},
        "real_valkey_coverage": {"type": "boolean"},
        "dry_run_only": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "blocking", "description", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "category": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
