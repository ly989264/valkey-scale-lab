{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Loop Quant Summary",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "capability_id",
    "run_id",
    "created_at",
    "producer",
    "status",
    "summary",
    "artifact_refs",
    "missing_data",
    "runtime_claims"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "quant_summary"},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_REASON"]},
    "summary": {"type": "string", "minLength": 1},
    "artifact_refs": {"type": "array", "items": {"type": "string"}},
    "missing_data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "status", "reason"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_REASON"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "runtime_claims": {
      "type": "object",
      "required": ["real_valkey_claimed", "management_runtime_claimed", "fault_runtime_claimed"],
      "properties": {
        "real_valkey_claimed": {"type": "boolean"},
        "management_runtime_claimed": {"type": "boolean"},
        "fault_runtime_claimed": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
