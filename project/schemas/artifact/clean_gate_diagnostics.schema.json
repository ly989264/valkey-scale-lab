{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clean Gate Diagnostics",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "capability_id",
    "run_id",
    "status",
    "clean_gate_total_ms",
    "probe_round_count",
    "full_probe_count",
    "representative_probe_count",
    "all_nodes_probe_count",
    "probe_timeout_count",
    "max_single_probe_ms",
    "slowest_probe_node",
    "slowest_probe_ms",
    "last_failing_reason"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "clean_gate_diagnostics"},
    "capability_id": {"type": "string"},
    "run_id": {"type": "string"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "clean_gate_total_ms": {"type": ["number", "string"]},
    "probe_round_count": {"type": "integer", "minimum": 0},
    "full_probe_count": {"type": "integer", "minimum": 0},
    "representative_probe_count": {"type": "integer", "minimum": 0},
    "all_nodes_probe_count": {"type": "integer", "minimum": 0},
    "probe_timeout_count": {"type": "integer", "minimum": 0},
    "last_failing_reason": {"type": "string"}
  },
  "additionalProperties": true
}
