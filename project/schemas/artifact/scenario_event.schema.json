{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Valkey Scenario Event",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "capability_id",
    "scenario_name",
    "sample_id",
    "event_id",
    "event_type",
    "timestamp_unix_ms",
    "monotonic_ms",
    "severity",
    "subject_type",
    "subject_id",
    "operation_id",
    "fault_id",
    "message",
    "metadata"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "run_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "scenario_name": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "timestamp_unix_ms": {"type": ["integer", "string"]},
    "monotonic_ms": {"type": ["number", "string"]},
    "severity": {"type": "string", "enum": ["DEBUG", "INFO", "WARN", "ERROR"]},
    "subject_type": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string"},
    "operation_id": {"type": "string"},
    "fault_id": {"type": "string"},
    "message": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
