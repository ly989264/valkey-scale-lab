{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valkey-scale-lab.local/schemas/evidence_admission_candidate.schema.json",
  "title": "Valkey Scale Lab candidate admission envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_kind", "run_id", "run_nonce", "run_started_unix_ms", "run_ended_unix_ms", "source_commit", "product_digest", "definition_digest", "capture_digest", "admission_digest", "requested_nodes", "observed_nodes", "status", "valkey_versions", "independent_probe", "cleanup", "capture_manifest", "provenance", "artifacts"],
  "properties": {
    "schema_version": {"const": "valkey-exact-scale-admission-v1"},
    "execution_kind": {"const": "REAL_VALKEY_EXACT_SCALE"},
    "run_id": {"type": "string", "minLength": 1},
    "invocation_run_id": {"type": "string", "minLength": 1},
    "run_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "run_started_unix_ms": {"type": "integer"},
    "run_ended_unix_ms": {"type": "integer"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "product_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "definition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capture_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "admission_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "promoted_from_admission_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_nodes": {"type": "integer", "minimum": 30, "maximum": 2000},
    "observed_nodes": {"type": "integer", "minimum": 30, "maximum": 2000},
    "status": {"const": "PASS"},
    "valkey_versions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^9\\.1(?:\\.[0-9]+)?$"}},
    "independent_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed_nodes", "cluster_state", "slots_assigned", "slots_ok", "endpoint_count"],
      "properties": {
        "status": {"const": "PASS"},
        "observed_nodes": {"type": "integer", "minimum": 30, "maximum": 2000},
        "cluster_state": {"const": "ok"},
        "slots_assigned": {"const": 16384},
        "slots_ok": {"const": 16384},
        "endpoint_count": {"type": "integer", "minimum": 2}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "residual_owned_resources", "source"],
      "properties": {
        "status": {"const": "PASS"},
        "residual_owned_resources": {"const": 0},
        "source": {"const": "runtime/cleanup_report.json"}
      }
    },
    "capture_manifest": {"$ref": "#/$defs/documentReference"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "source_path", "source_sha256", "transform_id", "provenance_node_id"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_path": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "transform_id": {"type": ["string", "null"]},
          "provenance_node_id": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "documentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
