{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stability Soak Metrics Rollup",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "created_at",
    "producer",
    "status",
    "summary",
    "profiles",
    "scale_planning_boundary",
    "findings"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "stability_soak_metrics"},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "summary": {
      "type": "object",
      "required": [
        "required_node_counts",
        "profile_count",
        "measured_profile_count",
        "resource_aware_profile_count",
        "missing_metric_count",
        "blocking_findings_count"
      ],
      "additionalProperties": true
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "artifact_type",
          "capability_id",
          "run_id",
          "created_at",
          "producer",
          "status",
          "node_count",
          "evidence_layer",
          "evidence_class",
          "real_valkey_coverage",
          "resource_aware",
          "bounded",
          "long_run_stability_claim",
          "windows",
          "metric_records",
          "source_artifacts",
          "source_hashes"
        ],
        "properties": {
          "schema_version": {"type": "string", "const": "v1"},
          "artifact_type": {"type": "string", "const": "stability_soak_profile"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED_WITH_REASON", "BLOCKED"]},
          "node_count": {"type": "integer", "minimum": 1, "maximum": 100},
          "evidence_layer": {"type": "string", "enum": ["small-real", "30", "50", "100"]},
          "evidence_class": {"type": "string", "enum": ["real_valkey", "resource_aware_profile"]},
          "real_valkey_coverage": {"type": "boolean"},
          "resource_aware": {"type": "boolean"},
          "bounded": {"type": "boolean"},
          "long_run_stability_claim": {"type": "boolean", "const": false},
          "windows": {
            "type": "object",
            "required": ["baseline", "steady", "fault", "recovery", "post_recovery"],
            "additionalProperties": true
          },
          "metric_records": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_hashes": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        },
        "additionalProperties": true
      }
    },
    "scale_planning_boundary": {
      "type": "object",
      "required": ["capability_id", "status", "real_valkey_coverage", "dry_run_only"],
      "properties": {
        "capability_id": {"type": "string", "const": "scale_planning"},
        "status": {"type": "string", "enum": ["SKIPPED_WITH_REASON"]},
        "real_valkey_coverage": {"type": "boolean", "const": false},
        "dry_run_only": {"type": "boolean", "const": true}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "blocking", "description", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "category": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
