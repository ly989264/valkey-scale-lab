{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Setup Timeline",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "capability_id",
    "timeline_kind",
    "run_id",
    "scenario",
    "profile_id",
    "created_at",
    "producer",
    "status",
    "node_count",
    "setup_command_wall_seconds",
    "setup_timeline_total_seconds",
    "setup_timeline_unexplained_seconds",
    "setup_timeline_unexplained_status",
    "segments",
    "stage_hierarchy",
    "required_stage_coverage",
    "largest_segments",
    "largest_gaps",
    "real_valkey_evidence_summary",
    "summary",
    "errors"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "setup_timeline"},
    "capability_id": {"type": "string", "minLength": 1},
    "timeline_kind": {"type": "string", "const": "setup_timeline"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "enum": ["fake", "small-real", "exact-10", "exact-30", "exact-50", "exact-100", "exact-200"]},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {"type": "object"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "node_count": {"type": "integer", "minimum": 0, "maximum": 200},
    "setup_command_wall_seconds": {"type": "number", "minimum": 0},
    "setup_timeline_total_seconds": {"type": "number", "minimum": 0},
    "setup_timeline_unexplained_seconds": {"type": "number", "minimum": 0},
    "setup_timeline_unexplained_status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "category",
          "start_monotonic",
          "end_monotonic",
          "duration_seconds",
          "status",
          "details"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^segment_[0-9]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["span", "gap"]},
          "category": {"type": "string", "minLength": 1},
          "start_monotonic": {"type": "number", "minimum": 0},
          "end_monotonic": {"type": "number", "minimum": 0},
          "duration_seconds": {"type": "number", "minimum": 0},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED_WITH_REASON"]},
          "details": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "at_monotonic",
          "elapsed_seconds",
          "details"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^event_[0-9]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "at_monotonic": {"type": "number", "minimum": 0},
          "elapsed_seconds": {"type": "number", "minimum": 0},
          "details": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "stage_hierarchy": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "category",
          "inclusive_duration_seconds",
          "exclusive_duration_seconds",
          "children",
          "status"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "inclusive_duration_seconds": {"type": "number", "minimum": 0},
          "exclusive_duration_seconds": {"type": "number", "minimum": 0},
          "children": {"type": "array"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING"]}
        },
        "additionalProperties": true
      }
    },
    "required_stage_coverage": {
      "type": "object",
      "required": ["required_segments", "required_groups", "status"],
      "properties": {
        "required_segments": {"type": "object"},
        "required_groups": {"type": "object"},
        "status": {"type": "string", "enum": ["PASS", "FAIL"]}
      },
      "additionalProperties": true
    },
    "largest_segments": {"type": "array"},
    "largest_gaps": {"type": "array"},
    "real_valkey_evidence_summary": {
      "type": "object",
      "required": ["status", "real_valkey", "nodes_observed", "data_path_result", "role_counts", "valkey_versions"],
      "additionalProperties": true
    },
    "source_artifacts": {"type": "array"},
    "summary": {
      "type": "object",
      "required": [
        "setup_command_wall_seconds",
        "setup_timeline_total_seconds",
        "setup_timeline_unexplained_seconds",
        "setup_timeline_unexplained_status",
        "largest_segments",
        "largest_gaps"
      ],
      "additionalProperties": true
    },
    "errors": {"type": "array"}
  },
  "additionalProperties": true
}
