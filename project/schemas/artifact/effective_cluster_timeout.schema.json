{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Effective Cluster Timeout",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "requested_cluster_node_timeout_ms",
    "effective_cluster_node_timeout_ms",
    "cluster_node_timeout_source"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "effective_cluster_timeout"},
    "requested_cluster_node_timeout_ms": {"type": "integer", "minimum": 100, "maximum": 600000},
    "effective_cluster_node_timeout_ms": {"type": "integer", "minimum": 100, "maximum": 600000},
    "cluster_node_timeout_source": {"type": "string", "enum": ["global", "profile", "scenario", "cli"]},
    "cluster_node_timeout_profile": {"type": "string"},
    "cluster_node_timeout_matrix_ms": {
      "type": "array",
      "items": {"type": "integer", "minimum": 100, "maximum": 600000}
    }
  },
  "additionalProperties": true
}
