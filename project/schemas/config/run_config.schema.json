{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run Config",
  "type": "object",
  "required": [
    "schema_version",
    "profile_name",
    "safety",
    "runtime",
    "hosts",
    "network",
    "cluster"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v1$"
    },
    "profile_name": {
      "type": "string",
      "minLength": 1
    },
    "safety": {
      "type": "object",
      "required": [
        "default_max_nodes",
        "allow_1000_nodes",
        "require_sandbox_network",
        "forbid_host_network_mutation",
        "cleanup_on_error"
      ],
      "properties": {
        "default_max_nodes": {
          "type": "integer",
          "maximum": 100
        },
        "allow_1000_nodes": {
          "type": "boolean"
        },
        "require_1000_env": {
          "type": "string"
        },
        "require_sandbox_network": {
          "type": "boolean"
        },
        "forbid_host_network_mutation": {
          "type": "boolean"
        },
        "cleanup_on_error": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": [
        "provider",
        "valkey_image",
        "sandbox_mode"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "docker",
            "ecs"
          ]
        },
        "valkey_image": {
          "type": "string"
        },
        "sandbox_mode": {
          "type": "string",
          "enum": [
            "container_namespace",
            "sandbox_proxy"
          ]
        },
        "dry_run": {
          "type": "boolean"
        },
        "server_profile": {
          "type": "string",
          "enum": [
            "correctness",
            "one_b_dev",
            "one_b_perf"
          ]
        },
        "valkey": {
          "type": "object",
          "properties": {
            "io_threads": {
              "type": "integer",
              "minimum": 1
            },
            "io_threads_auto": {
              "type": "boolean"
            },
            "io_threads_max_per_node": {
              "type": "integer",
              "minimum": 1
            },
            "io_threads_max_total": {
              "type": "integer",
              "minimum": 1
            },
            "log_format": {
              "type": "string",
              "enum": [
                "text",
                "json"
              ]
            }
          },
          "additionalProperties": true
        },
        "nodehost_strategy": {
          "type": "string",
          "enum": [
            "density_limited"
          ]
        },
        "max_nodehosts": {
          "type": "integer",
          "minimum": 1
        },
        "nodehosts_per_az": {
          "type": "integer",
          "minimum": 1
        },
        "max_logical_nodes_per_nodehost": {
          "type": "integer",
          "minimum": 1
        },
        "nodehost_distribution": {
          "type": "string",
          "enum": [
            "round_robin_by_az"
          ]
        }
      },
      "additionalProperties": true
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "host_id",
          "ip",
          "docker_endpoint"
        ],
        "properties": {
          "host_id": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "ip": {
            "type": "string"
          },
          "docker_endpoint": {
            "type": "string"
          },
          "memory_gb": {},
          "disk_gb": {},
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "network": {
      "type": "object",
      "required": [
        "virtual_az_mode",
        "azs"
      ],
      "properties": {
        "virtual_az_mode": {
          "type": "string",
          "enum": [
            "single",
            "multi"
          ]
        },
        "azs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "cluster": {
      "type": "object",
      "required": [
        "shards",
        "replicas_per_shard",
        "port_base",
        "cluster_bus_port_base"
      ],
      "properties": {
        "shards": {
          "type": "integer",
          "minimum": 1
        },
        "replicas_per_shard": {
          "type": "integer",
          "minimum": 0
        },
        "port_base": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "cluster_bus_port_base": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "node_memory_limit_mb": {
          "type": "integer",
          "minimum": 1
        },
        "cluster_node_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "cluster_node_timeout_profile": {
          "type": "string"
        },
        "cluster_node_timeout_allow_override": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "fault": {
      "type": "object",
      "properties": {
        "cluster_node_timeout_matrix_ms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 600000
          }
        }
      },
      "additionalProperties": true
    },
    "observability": {
      "type": "object",
      "properties": {
        "failover_timeline_observer": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "probe_interval_ms": {
              "type": "integer",
              "minimum": 50,
              "maximum": 60000
            },
            "client_probe_interval_ms": {
              "type": "integer",
              "minimum": 50,
              "maximum": 60000
            },
            "probe_timeout_ms": {
              "type": "integer",
              "minimum": 50,
              "maximum": 60000
            },
            "max_observer_endpoints": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cluster_node_timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 600000
          },
          "allow_override": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "workload": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"type": "string", "enum": ["smoke", "benchmark"]},
        "profiles": {
          "type": "array",
          "items": {"type": "string", "enum": ["smoke", "uniform", "hotspot", "mixed_rw", "write_heavy", "read_heavy"]}
        },
        "target_qps": {"type": "number", "minimum": 0},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "warmup_seconds": {"type": "number", "minimum": 0},
        "connections": {"type": "integer", "minimum": 1},
        "pipeline": {"type": "integer", "minimum": 1},
        "keyspace": {"type": "integer", "minimum": 1},
        "value_size": {"type": "integer", "minimum": 1},
        "hash_slot_distribution": {"type": "string", "enum": ["single_tag", "multi_slot", "full_slot", "hotspot"]},
        "read_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "write_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "uniform_qps": {"type": "number", "minimum": 0},
        "hotspot_qps": {"type": "number", "minimum": 0},
        "hotspot_key_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "timing": {"type": "string"}
      },
      "additionalProperties": true
    },
    "faults": {
      "type": "array"
    },
    "scale_profile": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
