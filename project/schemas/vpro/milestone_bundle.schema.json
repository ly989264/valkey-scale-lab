{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vpro:schema:milestone-bundle:v1",
  "title": "VPRO Milestone Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone",
    "clauses",
    "tiers",
    "checks",
    "objectives",
    "profiles",
    "gates",
    "acceptance",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "vpro-bundle-v1"},
    "milestone": {"$ref": "#/$defs/milestone"},
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/clause"}
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tier"}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/objective"}
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/profile"}
    },
    "gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/gate"}
    },
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*(?:^|/)\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "cwdPath": {
      "oneOf": [
        {"const": "."},
        {"$ref": "#/$defs/safePath"}
      ]
    },
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safePath"}
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "goal"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "title": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1}
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rank", "cost", "reviewer_admissible"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "rank": {"type": "integer", "minimum": 0},
        "cost": {"enum": ["cheap", "normal", "expensive", "operator"]},
        "reviewer_admissible": {"type": "boolean"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "argv",
        "cwd",
        "timeout_seconds",
        "inputs",
        "outputs",
        "authority",
        "capabilities",
        "cache",
        "mode"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "tier": {"$ref": "#/$defs/identifier"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "cwd": {"$ref": "#/$defs/cwdPath"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "inputs": {"$ref": "#/$defs/pathList"},
        "outputs": {"$ref": "#/$defs/pathList"},
        "authority": {"enum": ["bundle", "evaluator"]},
        "capabilities": {"$ref": "#/$defs/idList"},
        "cache": {"enum": ["by_input_digest", "never"]},
        "mode": {"enum": ["standard", "capture", "admission"]}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "standard"}}},
          "then": {"properties": {"outputs": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"mode": {"enum": ["capture", "admission"]}}},
          "then": {"properties": {"outputs": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"mode": {"const": "capture"}}},
          "then": {"properties": {"cache": {"const": "never"}}}
        }
      ]
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "depends_on",
        "clause_ids",
        "context_paths",
        "worker_write_paths",
        "check_ids",
        "required_for_milestone"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "depends_on": {"$ref": "#/$defs/idList"},
        "clause_ids": {
          "allOf": [
            {"$ref": "#/$defs/idList"},
            {"minItems": 1}
          ]
        },
        "context_paths": {"$ref": "#/$defs/pathList"},
        "worker_write_paths": {"$ref": "#/$defs/pathList"},
        "check_ids": {
          "allOf": [
            {"$ref": "#/$defs/idList"},
            {"minItems": 1}
          ]
        },
        "required_for_milestone": {"type": "boolean"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim",
        "objective_ids",
        "include_dependency_closure",
        "gate_ids"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "claim": {"enum": ["MILESTONE_COMPLETE", "PROFILE_COMPLETE"]},
        "objective_ids": {
          "allOf": [
            {"$ref": "#/$defs/idList"},
            {"minItems": 1}
          ]
        },
        "include_dependency_closure": {"const": true},
        "gate_ids": {"$ref": "#/$defs/idList"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "after_objective_ids",
        "operator_approval_required",
        "required_for_milestone"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["program", "evidence"]},
        "after_objective_ids": {"$ref": "#/$defs/idList"},
        "check_ids": {
          "allOf": [
            {"$ref": "#/$defs/idList"},
            {"minItems": 1}
          ]
        },
        "preflight_check_ids": {
          "allOf": [
            {"$ref": "#/$defs/idList"},
            {"minItems": 1}
          ]
        },
        "capture_check_id": {"$ref": "#/$defs/identifier"},
        "admission_check_ids": {
          "allOf": [
            {"$ref": "#/$defs/idList"},
            {"minItems": 1}
          ]
        },
        "operator_approval_required": {"type": "boolean"},
        "required_for_milestone": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": {"kind": {"const": "program"}}
          },
          "then": {
            "required": ["check_ids"],
            "not": {
              "anyOf": [
                {"required": ["preflight_check_ids"]},
                {"required": ["capture_check_id"]},
                {"required": ["admission_check_ids"]}
              ]
            }
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": {"kind": {"const": "evidence"}}
          },
          "then": {
            "required": [
              "preflight_check_ids",
              "capture_check_id",
              "admission_check_ids"
            ],
            "not": {"required": ["check_ids"]}
          }
        }
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_rule",
        "milestone_rule",
        "common_check_ids",
        "closure_check_ids",
        "evaluator_guard_check_ids",
        "max_attempts",
        "stagnation_limit",
        "max_replans",
        "max_review_rounds",
        "max_new_gaps_per_review",
        "max_context_bytes",
        "failure_excerpt_bytes",
        "cache_unchanged_results",
        "max_expensive_runs_per_input"
      ],
      "properties": {
        "objective_rule": {"const": "CURRENT_PROGRAM_PASS_AND_BOUNDED_REVIEW"},
        "milestone_rule": {
          "const": "ALL_SELECTED_REQUIRED_OBJECTIVES_GATES_AND_CLOSURE_CURRENT"
        },
        "common_check_ids": {"$ref": "#/$defs/idList"},
        "closure_check_ids": {
          "allOf": [
            {"$ref": "#/$defs/idList"},
            {"minItems": 1}
          ]
        },
        "evaluator_guard_check_ids": {
          "allOf": [
            {"$ref": "#/$defs/idList"},
            {"minItems": 1}
          ]
        },
        "max_attempts": {"type": "integer", "minimum": 1},
        "stagnation_limit": {"type": "integer", "minimum": 1},
        "max_replans": {"type": "integer", "minimum": 0},
        "max_review_rounds": {"type": "integer", "minimum": 1},
        "max_new_gaps_per_review": {"const": 1},
        "max_context_bytes": {"type": "integer", "minimum": 1},
        "failure_excerpt_bytes": {"type": "integer", "minimum": 1},
        "cache_unchanged_results": {"const": true},
        "max_expensive_runs_per_input": {"type": "integer", "minimum": 1}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_roots",
        "evaluator_paths",
        "evaluator_repair_paths",
        "authoritative_check_paths",
        "evidence_roots",
        "allowed_tools"
      ],
      "properties": {
        "product_roots": {
          "allOf": [
            {"$ref": "#/$defs/pathList"},
            {"minItems": 1}
          ]
        },
        "evaluator_paths": {
          "allOf": [
            {"$ref": "#/$defs/pathList"},
            {"minItems": 1}
          ]
        },
        "evaluator_repair_paths": {
          "allOf": [
            {"$ref": "#/$defs/pathList"},
            {"minItems": 1}
          ]
        },
        "authoritative_check_paths": {
          "allOf": [
            {"$ref": "#/$defs/pathList"},
            {"minItems": 1}
          ]
        },
        "evidence_roots": {"$ref": "#/$defs/pathList"},
        "allowed_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          }
        }
      }
    }
  }
}
