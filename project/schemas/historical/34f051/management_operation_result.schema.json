{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Management Operation Result",
  "type": "object",
  "required": [
    "schema_version",
    "phase_id",
    "operation_name",
    "operation_id",
    "node_count",
    "operation_status",
    "started_at_unix_ms",
    "ended_at_unix_ms",
    "wall_ms",
    "command_ms",
    "convergence_ms",
    "cluster_state_before",
    "cluster_state_after",
    "slots_before",
    "slots_after",
    "workload_window_ref",
    "errors_by_type",
    "missing_fields"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "operation_name": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "node_count": {"type": "integer", "minimum": 1},
    "operation_status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_REASON", "PASS_NOOP_VERIFIED"]},
    "started_at_unix_ms": {"type": ["integer", "string"]},
    "ended_at_unix_ms": {"type": ["integer", "string"]},
    "wall_ms": {"type": ["number", "string"]},
    "command_ms": {"type": ["number", "string"]},
    "convergence_ms": {"type": ["number", "string"]},
    "cluster_state_before": {"type": "string", "minLength": 1},
    "cluster_state_after": {"type": "string", "minLength": 1},
    "slots_before": {"type": ["integer", "string"]},
    "slots_after": {"type": ["integer", "string"]},
    "workload_window_ref": {"type": "string", "minLength": 1},
    "errors_by_type": {"type": "object"},
    "missing_fields": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
