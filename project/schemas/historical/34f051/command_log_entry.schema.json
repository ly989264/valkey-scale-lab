{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Loop Command Log Entry",
  "type": "object",
  "required": ["schema_version", "phase_id", "run_id", "command_id", "command_kind", "started_at_unix_ms", "ended_at_unix_ms", "status"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "command_id": {"type": "string", "minLength": 1},
    "command_kind": {"type": "string", "minLength": 1},
    "started_at_unix_ms": {"type": ["integer", "string"]},
    "ended_at_unix_ms": {"type": ["integer", "string"]},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_REASON"]}
  },
  "additionalProperties": true
}
