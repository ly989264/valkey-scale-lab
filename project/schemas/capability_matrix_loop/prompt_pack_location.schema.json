{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "artifact_type", "prompt_pack_path", "files_found"],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "capability_prompt_pack_location"},
    "prompt_pack_path": {"type": "string", "minLength": 1},
    "files_found": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]}
  },
  "additionalProperties": true
}
