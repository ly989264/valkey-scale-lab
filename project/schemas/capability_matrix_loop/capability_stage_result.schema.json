{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "artifact_type", "stage_id", "status", "created_at", "git", "previous_harness", "current_harness", "real_valkey_evidence", "capability_matrix_delta", "audit"],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "capability_loop_stage_result"},
    "stage_id": {"type": "string", "pattern": "^CML[0-9]{2}[A-Z]?_[A-Z0-9_]+$"},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
    "created_at": {"type": "string", "minLength": 1},
    "git": {
      "type": "object",
      "required": ["branch", "head_before", "head_after", "pushed"],
      "properties": {
        "branch": {"type": "string"},
        "head_before": {"type": "string"},
        "head_after": {"type": "string"},
        "pushed": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "previous_harness": {
      "type": "object",
      "required": ["status", "commands"],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
        "commands": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "current_harness": {
      "type": "object",
      "required": ["status", "freeze_sha256", "negative_tests_passed"],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "FAIL"]},
        "freeze_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
        "negative_tests_passed": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "real_valkey_evidence": {
      "type": "object",
      "required": ["required", "scale_rungs", "evidence_paths"],
      "properties": {
        "required": {"type": "boolean"},
        "scale_rungs": {"type": "array", "items": {"type": "integer"}},
        "evidence_paths": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "capability_matrix_delta": {"type": "array", "items": {"type": "object"}},
    "audit": {
      "type": "object",
      "required": ["decision", "path"],
      "properties": {
        "decision": {"type": "string", "enum": ["PASS", "FAIL"]},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
