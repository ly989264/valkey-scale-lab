diff --git a/src/commands/cluster-myslots.json b/src/commands/cluster-myslots.json
new file mode 100644
index 0000000..f0a49a7
--- /dev/null
+++ b/src/commands/cluster-myslots.json
@@ -0,0 +1,57 @@
+{
+    "MYSLOTS": {
+        "summary": "Returns the current shard's slot bitmap and identifying metadata.",
+        "complexity": "O(1)",
+        "group": "cluster",
+        "since": "9.1.0",
+        "arity": 2,
+        "container": "CLUSTER",
+        "function": "clusterCommand",
+        "command_flags": [
+            "LOADING",
+            "STALE"
+        ],
+        "command_tips": [
+            "NONDETERMINISTIC_OUTPUT"
+        ],
+        "reply_schema": {
+            "description": "The local node and shard identifiers plus a fixed-length LSB0 slot bitmap.",
+            "type": "object",
+            "additionalProperties": false,
+            "properties": {
+                "node-id": {
+                    "type": "string"
+                },
+                "shard-id": {
+                    "type": "string"
+                },
+                "role": {
+                    "oneOf": [
+                        {
+                            "const": "primary"
+                        },
+                        {
+                            "const": "replica"
+                        }
+                    ]
+                },
+                "slot-owner-id": {
+                    "type": "string"
+                },
+                "slot-count": {
+                    "type": "integer"
+                },
+                "bitmap-encoding": {
+                    "const": "lsb0"
+                },
+                "slot-bitmap": {
+                    "description": "A 2048-byte binary string representing all 16384 cluster slots.",
+                    "type": "string"
+                }
+            }
+        },
+        "acl_categories": [
+            "SLOW"
+        ]
+    }
+}
diff --git a/tests/unit/cluster/cluster-myslots.tcl b/tests/unit/cluster/cluster-myslots.tcl
new file mode 100644
index 0000000..786832e
--- /dev/null
+++ b/tests/unit/cluster/cluster-myslots.tcl
@@ -0,0 +1,70 @@
+proc myslots_dict {node} {
+    return [dict create {*}[R $node CLUSTER MYSLOTS]]
+}
+
+proc bitmap_has_slot {bitmap slot} {
+    binary scan [string index $bitmap [expr {$slot >> 3}]] cu byte
+    return [expr {($byte & (1 << ($slot & 7))) != 0}]
+}
+
+proc bitmap_popcount {bitmap} {
+    binary scan $bitmap cu* bytes
+    set count 0
+    foreach byte $bytes {
+        for {set bit 0} {$bit < 8} {incr bit} {
+            incr count [expr {($byte >> $bit) & 1}]
+        }
+    }
+    return $count
+}
+
+start_cluster 3 3 {tags {external:skip cluster}} {
+    test "CLUSTER MYSLOTS returns an ordered RESP2 reply with a fixed LSB0 bitmap" {
+        set reply [R 0 CLUSTER MYSLOTS]
+        set keys {}
+        foreach {key value} $reply {
+            lappend keys $key
+        }
+        assert_equal {node-id shard-id role slot-owner-id slot-count bitmap-encoding slot-bitmap} $keys
+
+        set result [dict create {*}$reply]
+        assert_equal 40 [string length [dict get $result node-id]]
+        assert_equal 40 [string length [dict get $result shard-id]]
+        assert_equal primary [dict get $result role]
+        assert_equal [dict get $result node-id] [dict get $result slot-owner-id]
+        assert_equal 2048 [string length [dict get $result slot-bitmap]]
+        assert_equal lsb0 [dict get $result bitmap-encoding]
+        assert_equal [dict get $result slot-count] [bitmap_popcount [dict get $result slot-bitmap]]
+        assert_equal 1 [bitmap_has_slot [dict get $result slot-bitmap] 0]
+        assert_equal 1 [bitmap_has_slot [dict get $result slot-bitmap] 5461]
+        assert_equal 0 [bitmap_has_slot [dict get $result slot-bitmap] 5462]
+    }
+
+    test "CLUSTER MYSLOTS returns the same shard bitmap from a replica" {
+        for {set primary 0} {$primary < 3} {incr primary} {
+            set replica [expr {$primary + 3}]
+            set primary_result [myslots_dict $primary]
+            set replica_result [myslots_dict $replica]
+
+            assert_equal replica [dict get $replica_result role]
+            assert_equal [R $replica CLUSTER MYID] [dict get $replica_result node-id]
+            assert_equal [dict get $primary_result shard-id] [dict get $replica_result shard-id]
+            assert_equal [dict get $primary_result node-id] [dict get $replica_result slot-owner-id]
+            assert_equal [dict get $primary_result slot-count] [dict get $replica_result slot-count]
+            assert_equal [dict get $primary_result slot-bitmap] [dict get $replica_result slot-bitmap]
+        }
+    }
+
+    test "CLUSTER MYSLOTS returns a RESP3 map" {
+        R 0 HELLO 3
+        set result [R 0 CLUSTER MYSLOTS]
+        assert_equal 7 [dict size $result]
+        assert_equal primary [dict get $result role]
+        assert_equal 2048 [string length [dict get $result slot-bitmap]]
+        R 0 HELLO 2
+    }
+
+    test "CLUSTER MYSLOTS rejects extra arguments" {
+        assert_error "*wrong number of arguments*" {R 0 CLUSTER MYSLOTS extra}
+    }
+}
