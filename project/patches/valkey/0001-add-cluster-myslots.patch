+void clusterCommandMySlots(client *c) {
+    clusterNode *node = myself;
+    clusterNode *slot_owner = node;
+    const char *role = "primary";
+
+    if (nodeIsReplica(node)) {
+        if (node->replicaof == NULL) {
+            addReplyError(c, "Replica primary is unknown");
+            return;
+        }
+        slot_owner = node->replicaof;
+        role = "replica";
+    }
+
+    addReplyMapLen(c, 7);
+    addReplyBulkCString(c, "node-id");
+    addReplyBulkCBuffer(c, node->name, CLUSTER_NAMELEN);
+    addReplyBulkCString(c, "shard-id");
+    addReplyBulkCBuffer(c, node->shard_id, CLUSTER_NAMELEN);
+    addReplyBulkCString(c, "role");
+    addReplyBulkCString(c, role);
+    addReplyBulkCString(c, "slot-owner-id");
+    addReplyBulkCBuffer(c, slot_owner->name, CLUSTER_NAMELEN);
+    addReplyBulkCString(c, "slot-count");
+    addReplyLongLong(c, slot_owner->numslots);
+    addReplyBulkCString(c, "bitmap-encoding");
+    addReplyBulkCString(c, "lsb0");
+    addReplyBulkCString(c, "slot-bitmap");
+    addReplyBulkCBuffer(c, slot_owner->slots, sizeof(slot_owner->slots));
+}
