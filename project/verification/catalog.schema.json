{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valkey-scale-lab.local/verification/catalog.schema.json",
  "title": "Valkey Scale Lab Executable Verification Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suites", "tests"],
  "properties": {
    "schema_version": {"const": "verification-catalog-v2"},
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/suite"}
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/test"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "description", "test_ids"],
      "properties": {
        "suite_id": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string", "minLength": 1},
        "test_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "description", "parameters", "runner"],
      "properties": {
        "test_id": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string", "minLength": 1},
        "parameters": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/parameter"}
        },
        "runner": {"$ref": "#/$defs/runner"}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": {"enum": ["string", "integer", "number", "boolean", "path"]},
        "required": {"type": "boolean"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "argv", "cwd", "timeout_seconds", "result"],
      "properties": {
        "type": {"enum": ["pytest", "command"]},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "cwd": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "result": {"enum": ["junit", "exit_code", "json"]}
      },
      "oneOf": [
        {
          "properties": {
            "type": {"const": "pytest"},
            "result": {"const": "junit"}
          }
        },
        {
          "properties": {
            "type": {"const": "command"},
            "result": {"enum": ["exit_code", "json"]}
          }
        }
      ]
    }
  }
}
