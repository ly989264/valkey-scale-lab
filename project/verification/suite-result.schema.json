{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valkey-scale-lab.local/verification/suite-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "status", "exit_code", "skipped", "started_at_unix", "captured_at_unix"],
  "properties": {
    "schema_version": {"const": "verification-suite-result-v1"},
    "suite_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "exit_code": {"type": "integer"},
    "skipped": {"type": "integer", "minimum": 0},
    "started_at_unix": {"type": "integer", "minimum": 1},
    "captured_at_unix": {"type": "integer", "minimum": 1}
  }
}
