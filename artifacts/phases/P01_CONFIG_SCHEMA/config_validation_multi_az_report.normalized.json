{
  "cluster": {
    "cluster_bus_port_base": 17100,
    "node_memory_limit_mb": 128,
    "port_base": 7100,
    "replicas_per_shard": 1,
    "shards": 3
  },
  "faults": [
    {
      "delay_ms": 100,
      "duration_seconds": 10,
      "fault_id": "az-a-latency-smoke",
      "jitter_ms": 10,
      "target": "az-a",
      "target_scope": "virtual_az",
      "type": "network_delay"
    }
  ],
  "hosts": [
    {
      "arch": "auto",
      "disk_gb": "auto",
      "docker_endpoint": "local",
      "host_id": "local",
      "ip": "127.0.0.1",
      "labels": [
        "controller",
        "worker"
      ],
      "memory_gb": "auto",
      "os": "auto"
    }
  ],
  "metadata": {},
  "network": {
    "azs": [
      "az-a",
      "az-b",
      "az-c"
    ],
    "virtual_az_mode": "multi"
  },
  "profile_name": "local_az_3x2",
  "runtime": {
    "dry_run": false,
    "provider": "docker",
    "sandbox_mode": "container_namespace",
    "valkey_image": "valkey/valkey:9.1.0"
  },
  "safety": {
    "allow_1000_nodes": false,
    "cleanup_on_error": true,
    "default_max_nodes": 100,
    "forbid_host_network_mutation": true,
    "require_sandbox_network": true
  },
  "scale_profile": {},
  "schema_version": "v1",
  "workload": {
    "enabled": true,
    "hotspot_key_fraction": 0.01,
    "hotspot_qps": 50,
    "pipeline": 4,
    "read_ratio": 0.8,
    "timing": "all_run",
    "uniform_qps": 200,
    "write_ratio": 0.2
  }
}
