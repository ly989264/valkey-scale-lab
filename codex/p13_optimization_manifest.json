{
  "version": "v1",
  "project": "valkey-scale-lab",
  "default_max_nodes": 100,
  "base_phase": "P13_SCALE_LADDER_50_100",
  "p14_opt_in_only": true,
  "phases": [
    {
      "id": "P13O-00_TIMING_ACCOUNTING",
      "artifact_phase_id": "P13O_TIMING_ACCOUNTING",
      "title": "P13 timing accounting and probe semantics",
      "automatic": true,
      "real_valkey_required": true,
      "max_nodes": 100,
      "objectives": [
        "Explain P13 scale_50 and scale_100 gate wall time",
        "Separate runtime final full probe timing from diagnostic full probe timing",
        "Preserve the existing P13 cluster startup algorithm"
      ],
      "gates": [
        {
          "name": "p13o_timing_tests",
          "kind": "unit",
          "command": "python3 -m pytest -q tests/unit/test_p13_timing_accounting.py tests/integration/test_docker_runtime_contract.py::test_p13_runtime_timing_names_split_diagnostic_probe",
          "timeout_seconds": 300,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "resource_preflight_50",
          "kind": "cli",
          "command": "python3 -m valkey_scale_lab.cli resource preflight --config templates/configs/scale_50.yaml --out artifacts/phases/P13_SCALE_LADDER_50_100/resource_preflight_50.json",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "scale_50_real_gate",
          "kind": "real_valkey_e2e",
          "command": "python3 scripts/valkey_e2e_gate.py --phase P13_SCALE_LADDER_50_100 --config templates/configs/scale_50.yaml --scenario scale_50 --out artifacts/phases/P13_SCALE_LADDER_50_100/valkey_e2e_evidence_50.json --min-nodes 50 --require-data-path",
          "timeout_seconds": 900,
          "required": true,
          "real_valkey": true
        },
        {
          "name": "resource_preflight_100",
          "kind": "cli",
          "command": "python3 -m valkey_scale_lab.cli resource preflight --config templates/configs/scale_100.yaml --out artifacts/phases/P13_SCALE_LADDER_50_100/resource_preflight_100.json",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "scale_100_real_gate",
          "kind": "real_valkey_e2e",
          "command": "python3 scripts/valkey_e2e_gate.py --phase P13_SCALE_LADDER_50_100 --config templates/configs/scale_100.yaml --scenario scale_100 --out artifacts/phases/P13_SCALE_LADDER_50_100/valkey_e2e_evidence_100.json --min-nodes 100 --require-data-path",
          "timeout_seconds": 900,
          "required": true,
          "real_valkey": true
        },
        {
          "name": "cleanup_report_check",
          "kind": "cleanup",
          "command": "python3 scripts/assert_cleanup.py --cleanup-report artifacts/phases/P13_SCALE_LADDER_50_100/cleanup_report.json",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "p13o_timing_artifact_check",
          "kind": "artifact",
          "command": "python3 scripts/p13_optimization_gate.py validate-artifacts --phase P13O-00_TIMING_ACCOUNTING",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        }
      ],
      "required_artifacts": [
        {
          "path": "artifacts/phases/P13_SCALE_LADDER_50_100/p13_timing_breakdown_scale_50.json",
          "schema": "schemas/artifact/p13_timing_breakdown.schema.json",
          "required": true
        },
        {
          "path": "artifacts/phases/P13_SCALE_LADDER_50_100/p13_timing_breakdown_scale_100.json",
          "schema": "schemas/artifact/p13_timing_breakdown.schema.json",
          "required": true
        },
        {
          "path": "artifacts/phases/P13O_TIMING_ACCOUNTING/phase_summary.json",
          "schema": "schemas/artifact/p13_optimization_phase_summary.schema.json",
          "required": true
        }
      ],
      "audit": {
        "md_path": "audit/P13O-00_TIMING_ACCOUNTING/AUDIT.md",
        "decision_json_path": "audit/P13O-00_TIMING_ACCOUNTING/audit_decision.json"
      }
    },
    {
      "id": "P13O-01_CLUSTER_CREATE_AB",
      "artifact_phase_id": "P13O_CLUSTER_CREATE_AB",
      "title": "Cluster create strategy comparison",
      "automatic": true,
      "real_valkey_required": true,
      "max_nodes": 100,
      "required_artifacts": [
        {
          "path": "artifacts/phases/P13O_CLUSTER_CREATE_AB/p13_cluster_create_strategy_comparison.json",
          "required": true
        }
      ]
    },
    {
      "id": "P13O-02_REPLICA_REPLICATE_BREAKDOWN",
      "artifact_phase_id": "P13O_REPLICA_REPLICATE_BREAKDOWN",
      "title": "Replica replicate timing breakdown",
      "automatic": true,
      "real_valkey_required": true,
      "max_nodes": 100
    },
    {
      "id": "P13O-03_CLEANUP_OPTIMIZATION",
      "artifact_phase_id": "P13O_CLEANUP_OPTIMIZATION",
      "title": "Cleanup timing and optimization",
      "automatic": true,
      "real_valkey_required": true,
      "max_nodes": 100
    },
    {
      "id": "P13O-04_FAST_TEST_SPLIT",
      "artifact_phase_id": "P13O_FAST_TEST_SPLIT",
      "title": "P13 fast and slow test split",
      "automatic": true,
      "real_valkey_required": false,
      "max_nodes": 0
    },
    {
      "id": "P13O-05_PERF_REGRESSION_BUDGET",
      "artifact_phase_id": "P13O_PERF_REGRESSION_BUDGET",
      "title": "P13 performance regression budget",
      "automatic": true,
      "real_valkey_required": true,
      "max_nodes": 100
    }
  ]
}
