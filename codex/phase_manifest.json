{
  "version": "v1",
  "project": "valkey-scale-lab",
  "default_max_nodes": 100,
  "valkey_version_required_prefix": "9.1.",
  "automatic_stop_after": "P13_SCALE_LADDER_50_100",
  "phases": [
    {
      "id": "P00_REPO_CONTRACT",
      "title": "Repository contract and immutable harness bootstrap",
      "automatic": true,
      "fake_only_allowed": true,
      "real_valkey_required": false,
      "max_nodes": 0,
      "objectives": [
        "Create package skeleton",
        "Preserve harness controls",
        "Establish CI and artifact conventions"
      ],
      "gates": [
        {
          "name": "harness_precheck",
          "kind": "harness",
          "command": "python3 scripts/codex_gate.py precheck --phase P00_REPO_CONTRACT",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "safety_static_scan",
          "kind": "safety",
          "command": "python3 scripts/safety_scan.py",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "schema_template_validation",
          "kind": "schema",
          "command": "python3 scripts/validate_json_schema.py --schema schemas/artifact/gate_result.schema.json --instance templates/artifacts/gate_result.example.json",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "scripts_compile",
          "kind": "unit",
          "command": "python3 -m compileall -q scripts",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "unit_tests",
          "kind": "unit",
          "command": "python3 -m pytest -q tests/unit",
          "timeout_seconds": 300,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "cli_help",
          "kind": "cli",
          "command": "python3 -m valkey_scale_lab.cli --help",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        }
      ],
      "required_artifacts": [
        {
          "path": "artifacts/phases/P00_REPO_CONTRACT/phase_summary.json",
          "schema": "schemas/artifact/phase_summary.schema.json",
          "required": true
        },
        {
          "path": "artifacts/phases/P00_REPO_CONTRACT/env_info.json",
          "schema": "schemas/artifact/env_info.schema.json",
          "required": true
        }
      ],
      "audit": {
        "md_path": "audit/P00_REPO_CONTRACT/AUDIT.md",
        "decision_json_path": "audit/P00_REPO_CONTRACT/audit_decision.json"
      }
    },
    {
      "id": "P01_CONFIG_SCHEMA",
      "title": "Configuration schema and validation",
      "automatic": true,
      "fake_only_allowed": true,
      "real_valkey_required": false,
      "max_nodes": 0,
      "objectives": [
        "Implement typed configuration model",
        "Reject unsafe defaults",
        "Emit normalized config artifacts"
      ],
      "gates": [
        {
          "name": "harness_precheck",
          "kind": "harness",
          "command": "python3 scripts/codex_gate.py precheck --phase P01_CONFIG_SCHEMA",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "safety_static_scan",
          "kind": "safety",
          "command": "python3 scripts/safety_scan.py",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "config_unit_tests",
          "kind": "unit",
          "command": "python3 -m pytest -q tests/unit tests/config",
          "timeout_seconds": 300,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "validate_single_mac_config",
          "kind": "cli",
          "command": "python3 -m valkey_scale_lab.cli config validate --config templates/configs/single_mac_6node.yaml --out artifacts/phases/P01_CONFIG_SCHEMA/config_validation_report.json",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "validate_multi_az_config",
          "kind": "cli",
          "command": "python3 -m valkey_scale_lab.cli config validate --config templates/configs/local_az_3x2.yaml --out artifacts/phases/P01_CONFIG_SCHEMA/config_validation_multi_az_report.json",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "emit_config_schema_report",
          "kind": "cli",
          "command": "python3 -m valkey_scale_lab.cli config emit-schema --out artifacts/phases/P01_CONFIG_SCHEMA/config_schema_report.json",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
        }
      ],
      "required_artifacts": [
        {
          "path": "artifacts/phases/P01_CONFIG_SCHEMA/phase_summary.json",
          "schema": "schemas/artifact/phase_summary.schema.json",
          "required": true
        },
        {
          "path": "artifacts/phases/P01_CONFIG_SCHEMA/config_validation_report.json",
          "schema": "schemas/artifact/config_validation_report.schema.json",
          "required": true
