        {
          "path": "artifacts/phases/P01_CONFIG_SCHEMA/config_validation_multi_az_report.json",
          "schema": "schemas/artifact/config_validation_report.schema.json",
          "required": true
        },
        {
          "path": "artifacts/phases/P01_CONFIG_SCHEMA/config_schema_report.json",
          "schema": "schemas/artifact/config_schema_report.schema.json",
          "required": true
        }
      ],
      "audit": {
        "md_path": "audit/P01_CONFIG_SCHEMA/AUDIT.md",
        "decision_json_path": "audit/P01_CONFIG_SCHEMA/audit_decision.json"
      }
    },
