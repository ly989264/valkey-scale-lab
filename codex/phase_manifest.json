          "timeout_seconds": 180,
          "required": true,
          "real_valkey": false
        },
        {
          "name": "planner_1000_constraints",
          "kind": "schema",
          "command": "python3 scripts/assert_plan_constraints.py --plan artifacts/phases/P02_PLANNER/scale_1000_dryrun_plan.json --max-nodes 100 --allow-opt-in-1000 --require-dry-run",
          "timeout_seconds": 120,
          "required": true,
          "real_valkey": false
