    "version": "1.0.0",
    "title": "Multi-ECS scale-out",
    "goal": "Promote the proven native multi-ECS lifecycle through exact 500, 1000, and 2000 real Valkey nodes without reducing coverage, evidence quality, or cleanup safety."
  },
  "clauses": [
    {"id": "M3ExplicitProfiles", "text": "Provide explicit real execution profiles for exactly 500, 1000, and 2000 Valkey nodes."},
    {"id": "M3RungPreflight", "text": "Require quota, capacity, port, file-descriptor, memory, CPU, network, storage, credential, ownership, and cost preflight for every rung."},
    {"id": "M3BoundedOrchestration", "text": "Use bounded concurrency, batching, backpressure, retries, and resumable execution so control-plane work remains attributable and bounded."},
    {"id": "M3ScalableTelemetry", "text": "Scale metric ingestion and artifact transfer with explicit cardinality, retention, and sampling policies that preserve critical events and tail latency."},
    {"id": "M3HierarchicalSafety", "text": "Use hierarchical health, convergence, fault-target, ownership, and cleanup verification at every rung."},
    {"id": "M3SequentialPromotion", "text": "Admit exact 500 before 1000 and exact 1000 before 2000; dry runs, partial counts, and unbound prior evidence never satisfy promotion."},
    {"id": "M3LifecycleParity", "text": "Run the Milestone 2 lifecycle, stability, representative management, fault, failover, recovery, and cleanup contracts at every rung."},
    {"id": "M3NoReduction", "text": "Keep control and collection overhead bounded with no unexplained gaps, silent scenario reduction, fixture fallback, or cleanup residue."},
    {"id": "M3ScaleComparison", "text": "Produce validated comparisons against 200 and earlier rungs for latency, failures, workload impact, resources, efficiency, and cost."}
  ],
  "tiers": [
