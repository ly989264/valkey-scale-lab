    },
    {
      "id": "m1-50-admission", "tier": "expensive",
      "argv": ["python3", "checks/vpro/milestone_check.py", "admission", "--milestone", "1", "--scale", "50", "--capture", "m1/scale-50/capture", "--output", "m1/scale-50/admission"],
      "cwd": ".", "timeout_seconds": 1200,
      "inputs": ["checks/vpro/milestone_check.py", "evaluators/vpro/milestone1_evidence_policy.py", "evidence/m1/scale-50/capture"],
      "outputs": ["evidence/m1/scale-50/admission"],
      "mode": "admission", "authority": "evaluator", "capabilities": [], "cache": "by_input_digest"
    },
    {
      "id": "m1-200-preflight", "tier": "operator",
      "argv": ["python3", "checks/vpro/milestone_check.py", "preflight", "--milestone", "1", "--scale", "200", "--prior", "m1/scale-50/admission"],
      "cwd": ".", "timeout_seconds": 900,
      "inputs": ["checks/vpro/milestone_check.py", "src", "config", "templates", "evidence/m1/scale-50/admission"], "outputs": [],
      "mode": "standard", "authority": "bundle", "capabilities": ["container", "host_resource"], "cache": "never"
    },
    {
      "id": "m1-200-capture", "tier": "operator",
      "argv": ["python3", "checks/vpro/milestone_check.py", "capture", "--milestone", "1", "--scale", "200", "--prior", "m1/scale-50/admission", "--output", "m1/scale-200/capture"],
      "cwd": ".", "timeout_seconds": 14400,
      "inputs": ["checks/vpro/milestone_check.py", "src", "scripts", "schemas", "config", "templates", "evidence/m1/scale-50/admission"],
      "outputs": ["evidence/m1/scale-200/capture"],
      "mode": "capture", "authority": "bundle", "capabilities": ["container", "host_resource"], "cache": "never"
    },
    {
      "id": "m1-200-admission", "tier": "expensive",
      "argv": ["python3", "checks/vpro/milestone_check.py", "admission", "--milestone", "1", "--scale", "200", "--capture", "m1/scale-200/capture", "--prior", "m1/scale-50/admission", "--output", "m1/scale-200/admission"],
      "cwd": ".", "timeout_seconds": 1200,
      "inputs": ["checks/vpro/milestone_check.py", "evaluators/vpro/milestone1_evidence_policy.py", "evidence/m1/scale-50/admission", "evidence/m1/scale-200/capture"],
      "outputs": ["evidence/m1/scale-200/admission"],
      "mode": "admission", "authority": "evaluator", "capabilities": [], "cache": "by_input_digest"
    }
  ],
  "objectives": [
    {
      "id": "M1LifecycleScale", "title": "Canonical lifecycle and exact scale policy", "depends_on": [],
      "clause_ids": ["M1LocalLifecycle", "M1ExactNodePolicy"], "check_ids": ["m1-scenario-contract"],
      "context_paths": ["src/valkey_scale_lab/scenarios", "schemas/scenario", "templates"],
      "worker_write_paths": ["src/valkey_scale_lab/scenarios", "schemas/scenario", "templates"],
      "required_for_milestone": true
    },
    {
      "id": "M1ManagementFaultSafety", "title": "Management, stability, fault, and cleanup safety", "depends_on": ["M1LifecycleScale"],
      "clause_ids": ["M1ManagementStabilityFault", "M1FailoverRecovery", "M1OwnedCleanup"], "check_ids": ["m1-runtime-safety-contract"],
      "context_paths": ["src/valkey_scale_lab/gates", "src/valkey_scale_lab/runtime", "src/valkey_scale_lab/fault"],
      "worker_write_paths": ["src/valkey_scale_lab/gates", "src/valkey_scale_lab/runtime", "src/valkey_scale_lab/orchestrator", "src/valkey_scale_lab/fault", "src/valkey_scale_lab/workload", "src/valkey_scale_lab/management_matrix.py", "src/valkey_scale_lab/milestone1_gate.py"],
      "required_for_milestone": true
    },
    {
      "id": "M1EvidencePipeline", "title": "Diagnostic evidence and provenance", "depends_on": ["M1ManagementFaultSafety"],
      "clause_ids": ["M1DiagnosticTelemetry", "M1EvidenceProvenance"], "check_ids": ["m1-evidence-contract"],
      "context_paths": ["src/valkey_scale_lab/evidence", "src/valkey_scale_lab/observer", "schemas/artifact"],
      "worker_write_paths": ["src/valkey_scale_lab/evidence", "src/valkey_scale_lab/artifacts", "src/valkey_scale_lab/observer", "src/valkey_scale_lab/metrics", "schemas/artifact"],
      "required_for_milestone": true
    },
    {
      "id": "M1AnalysisReport", "title": "Validated offline analysis and reporting", "depends_on": ["M1EvidencePipeline"],
      "clause_ids": ["M1OfflineReport"], "check_ids": ["m1-report-contract"],
      "context_paths": ["src/valkey_scale_lab/analysis", "src/valkey_scale_lab/report"],
      "worker_write_paths": ["src/valkey_scale_lab/analysis", "src/valkey_scale_lab/report"],
      "required_for_milestone": true
    },
    {
      "id": "M1CompatibilityClosure", "title": "Compatibility and real-gate readiness", "depends_on": ["M1AnalysisReport"],
      "clause_ids": ["M1Exact50And200"], "check_ids": ["m1-compatibility-contract"],
      "context_paths": ["src/valkey_scale_lab/cli.py", "src/valkey_scale_lab/config", "src/valkey_scale_lab/planner", "config"],
      "worker_write_paths": ["src/valkey_scale_lab/cli.py", "src/valkey_scale_lab/config", "src/valkey_scale_lab/planner", "config"],
      "required_for_milestone": true
    }
  ],
  "profiles": [
    {"id": "complete", "objective_ids": ["M1CompatibilityClosure"], "include_dependency_closure": true, "gate_ids": ["M1Exact50", "M1Exact200"], "claim": "MILESTONE_COMPLETE"}
  ],
  "gates": [
    {
      "id": "M1Exact50", "kind": "evidence",
      "after_objective_ids": ["M1LifecycleScale", "M1ManagementFaultSafety", "M1EvidencePipeline", "M1AnalysisReport", "M1CompatibilityClosure"],
      "preflight_check_ids": ["m1-50-preflight"], "capture_check_id": "m1-50-capture", "admission_check_ids": ["m1-50-admission"],
      "operator_approval_required": true, "required_for_milestone": true
    },
    {
      "id": "M1Exact200", "kind": "evidence",
      "after_objective_ids": ["M1LifecycleScale", "M1ManagementFaultSafety", "M1EvidencePipeline", "M1AnalysisReport", "M1CompatibilityClosure"],
      "preflight_check_ids": ["m1-200-preflight"], "capture_check_id": "m1-200-capture", "admission_check_ids": ["m1-200-admission"],
      "operator_approval_required": true, "required_for_milestone": true
    }
  ],
  "acceptance": {
    "objective_rule": "CURRENT_PROGRAM_PASS_AND_BOUNDED_REVIEW",
    "milestone_rule": "ALL_SELECTED_REQUIRED_OBJECTIVES_GATES_AND_CLOSURE_CURRENT",
    "common_check_ids": ["m1-static-safety"], "closure_check_ids": ["m1-closure"], "evaluator_guard_check_ids": ["m1-evaluator-guard"],
    "max_attempts": 3, "stagnation_limit": 2, "max_replans": 1, "max_review_rounds": 2, "max_new_gaps_per_review": 1,
    "max_context_bytes": 24000, "failure_excerpt_bytes": 4000, "cache_unchanged_results": true, "max_expensive_runs_per_input": 1
