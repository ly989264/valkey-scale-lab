{
  "schema_version": "vpro-bundle-v1",
  "milestone": {
    "id": "Milestone1LocalLifecycle",
    "version": "1.0.1",
    "title": "Complete local cluster lifecycle",
    "goal": "Deliver the complete local Mac/Linux Valkey lifecycle through exact 50-node and 200-node real admission without weakening safety, evidence, or diagnostic depth."
  },
  "clauses": [
    {"id": "M1LocalLifecycle", "text": "Provide deterministic local startup, topology formation, readiness, stabilization, workload execution, and cleanup for real Valkey clusters."},
    {"id": "M1ManagementStabilityFault", "text": "Provide required management operations, bounded stability, and safely sandboxed process, placement, network, partition, flap, and minority/majority fault scenarios."},
    {"id": "M1FailoverRecovery", "text": "Measure client-visible availability, workload impact, cluster convergence, failover, recovery, and split-brain windows from observed evidence."},
    {"id": "M1ExactNodePolicy", "text": "Accept every exact requested size from 30 through 2000, retain runnable 30 and 100, never silently downscale, and require explicit approval above 200."},
    {"id": "M1Exact50And200", "text": "Require fresh exact 50-node and resource-preflight-gated exact 200-node real completion evidence."},
    {"id": "M1OwnedCleanup", "text": "Use attributable ownership and deterministic cleanup with no residual owned processes, containers, networks, ports, or state."},
    {"id": "M1DiagnosticTelemetry", "text": "Record stable monotonic lifecycle and recovery sub-stage timing with correlated resource, Valkey, workload, command, retry, timeout, and error telemetry."},
    {"id": "M1EvidenceProvenance", "text": "Reject incomplete, fixture-derived, stale, relabelled, fabricated, or cross-run real evidence and represent missing data explicitly."},
    {"id": "M1OfflineReport", "text": "Generate analysis and visual reports only from validated versioned artifacts and expose topology, timing, bottlenecks, resources, workload impact, failover, errors, cleanup, and missing evidence."}
  ],
  "tiers": [
    {"id": "cheap", "rank": 0, "cost": "cheap", "reviewer_admissible": true},
    {"id": "normal", "rank": 1, "cost": "normal", "reviewer_admissible": true},
    {"id": "expensive", "rank": 2, "cost": "expensive", "reviewer_admissible": false},
    {"id": "operator", "rank": 3, "cost": "operator", "reviewer_admissible": false}
  ],
  "checks": [
    {
      "id": "m1-static-safety", "tier": "cheap",
      "argv": ["python3", "checks/vpro/milestone_check.py", "static-safety"],
      "cwd": ".", "timeout_seconds": 300,
      "inputs": ["checks/vpro/milestone_check.py", "src", "tests", "scripts", "templates/configs", "pyproject.toml", "requirements-dev.txt"], "outputs": [],
      "mode": "standard", "authority": "bundle", "capabilities": [], "cache": "by_input_digest"
    },
    {
      "id": "m1-scenario-contract", "tier": "normal",
      "argv": ["python3", "checks/vpro/milestone_check.py", "suite", "--id", "m1-scenario"],
