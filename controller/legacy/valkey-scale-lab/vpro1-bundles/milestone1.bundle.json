      "inputs": ["checks/vpro/milestone_check.py", "src/valkey_scale_lab/scenarios", "schemas/scenario", "templates", "tests/scenarios"], "outputs": [],
      "mode": "standard", "authority": "bundle", "capabilities": [], "cache": "by_input_digest"
    },
    {
