    },
    {
      "id": "m1-50-capture", "tier": "operator",
      "argv": ["python3", "checks/vpro/milestone_check.py", "capture", "--milestone", "1", "--scale", "50", "--output", "m1/scale-50/capture"],
      "cwd": ".", "timeout_seconds": 14400,
      "inputs": ["checks/vpro/milestone_check.py", "src", "scripts", "schemas", "config", "templates"],
