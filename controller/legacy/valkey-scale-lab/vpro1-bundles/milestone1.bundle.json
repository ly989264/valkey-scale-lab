      "mode": "standard", "authority": "bundle", "capabilities": [], "cache": "by_input_digest"
    },
    {
      "id": "m1-evidence-contract", "tier": "normal",
      "argv": ["python3", "checks/vpro/milestone_check.py", "suite", "--id", "m1-evidence"],
      "cwd": ".", "timeout_seconds": 1800,
      "inputs": ["checks/vpro/milestone_check.py", "src/valkey_scale_lab/evidence", "src/valkey_scale_lab/artifacts", "src/valkey_scale_lab/observer", "src/valkey_scale_lab/metrics", "schemas/artifact", "tests/evidence", "tests/provenance/test_milestone1_gate_measured_sources.py", "tests/provenance/test_milestone1_gate_scenario_provenance.py"], "outputs": [],
      "mode": "standard", "authority": "bundle", "capabilities": [], "cache": "by_input_digest"
