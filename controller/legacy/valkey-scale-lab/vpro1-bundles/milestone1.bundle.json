      "mode": "standard", "authority": "bundle", "capabilities": [], "cache": "by_input_digest"
    },
    {
      "id": "m1-evaluator-guard", "tier": "normal",
      "argv": ["python3", "checks/vpro/milestone_check.py", "evaluator-guard", "--milestone", "1"],
