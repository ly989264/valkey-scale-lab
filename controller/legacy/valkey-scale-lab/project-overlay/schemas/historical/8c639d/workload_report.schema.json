{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workload_report",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "created_at",
    "producer",
    "status",
    "requested_qps",
    "achieved_qps",
    "latency",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v1$"
    },
    "artifact_type": {
      "type": "string",
      "const": "workload_report"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "MISSING",
        "SKIPPED_WITH_REASON",
        "NO_BASELINE_YET"
      ]
    },
    "requested_qps": {
      "type": "number",
      "minimum": 0
    },
    "achieved_qps": {
      "type": "number",
      "minimum": 0
    },
    "latency": {
      "type": "object"
    },
    "errors": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
