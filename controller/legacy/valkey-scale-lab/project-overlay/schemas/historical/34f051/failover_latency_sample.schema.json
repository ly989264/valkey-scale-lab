{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failover Latency Sample",
  "type": "object",
  "required": [
    "schema_version",
    "phase_id",
    "node_count",
    "sample_id",
    "target_primary_logical_id",
    "fault_injected_at_ms",
    "replica_promoted_at_ms",
    "slot_coverage_ok_at_ms",
    "first_successful_read_at_ms",
    "first_successful_write_at_ms",
    "promotion_latency_ms",
    "cluster_recovery_latency_ms",
    "read_unavailability_ms",
    "write_unavailability_ms",
    "workload_impact_ref"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "node_count": {"type": "integer", "minimum": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "target_primary_logical_id": {"type": "string", "minLength": 1},
    "fault_injected_at_ms": {"type": ["integer", "string"]},
    "replica_promoted_at_ms": {"type": ["integer", "string"]},
    "slot_coverage_ok_at_ms": {"type": ["integer", "string"]},
    "first_successful_read_at_ms": {"type": ["integer", "string"]},
    "first_successful_write_at_ms": {"type": ["integer", "string"]},
    "promotion_latency_ms": {"type": ["number", "string"]},
    "cluster_recovery_latency_ms": {"type": ["number", "string"]},
    "read_unavailability_ms": {"type": ["number", "string"]},
    "write_unavailability_ms": {"type": ["number", "string"]},
    "workload_impact_ref": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
