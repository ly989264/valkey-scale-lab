{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Management Operation Matrix",
  "type": "object",
  "required": ["schema_version", "artifact_type", "phase_id", "run_id", "operations"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "management_ops_matrix"},
    "phase_id": {"type": "string", "pattern": "^P[0-9]{2}_[A-Z0-9_]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation_name", "node_count", "operation_status", "workload_window_ref"],
        "properties": {
          "operation_name": {"type": "string", "minLength": 1},
          "node_count": {"type": "integer", "minimum": 1},
          "operation_status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_REASON", "PASS_NOOP_VERIFIED"]},
          "workload_window_ref": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
