{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strict Manifest Report",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "phase_id",
    "run_id",
    "created_at",
    "status",
    "manifest_path",
    "manifest_sha256",
    "automatic_stop_after",
    "default_max_nodes",
    "p14_automatic",
    "strict_stage_order",
    "bounded_200_exceptions",
    "p37_dry_run_target_nodes",
    "strict_stage_docs"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^v1$"},
    "artifact_type": {"type": "string", "const": "strict_manifest_report"},
    "phase_id": {"type": "string", "const": "P27_STRICT_MATRIX_REBASE_HARNESS"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "manifest_path": {"type": "string", "const": "codex/phase_manifest.json"},
    "manifest_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "automatic_stop_after": {"type": "string", "const": "P40_STRICT_FINAL_AUDIT_CLOSEOUT"},
    "default_max_nodes": {"type": "integer", "const": 100},
    "p14_automatic": {"type": "boolean", "const": false},
    "strict_stage_order": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {"type": "string"}
    },
    "bounded_200_exceptions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string"}
    },
    "p37_dry_run_target_nodes": {
      "type": "array",
      "minItems": 5,
      "items": {"type": "integer", "minimum": 201}
    },
    "strict_stage_docs": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
