{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "stage_id", "read_files", "active_constraints"],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "stage_id": {"type": "string", "pattern": "^CML[0-9]{2}[A-Z]?_[A-Z0-9_]+$"},
    "read_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "summary"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 64, "maxLength": 64},
          "summary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "active_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
