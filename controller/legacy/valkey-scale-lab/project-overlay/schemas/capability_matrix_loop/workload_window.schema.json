{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "artifact_type", "stage_id", "window_id", "status", "sample_count", "source_stage", "current_stage", "source_artifacts", "workload"],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "workload_window"},
    "stage_id": {"type": "string", "pattern": "^CML[0-9]{2}[A-Z]?_[A-Z0-9_]+$"},
    "window_id": {"type": "string", "enum": ["before", "operation_or_fault_apply", "during", "clear_or_recovery_start", "after_recovery", "all_run"]},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "MISSING", "SKIPPED_WITH_REASON", "UNSUPPORTED_WITH_EVIDENCE", "ABSENT_OBSERVED"]},
    "sample_count": {"type": "integer", "minimum": 0},
    "source_stage": {"type": "string", "minLength": 1},
    "current_stage": {"type": "string", "minLength": 1},
    "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "workload": {"type": "object"}
  },
  "additionalProperties": true
}
