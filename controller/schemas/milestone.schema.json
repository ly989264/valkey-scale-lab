{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:controller:schema:milestone:v1",
  "title": "Minimal Controller Milestone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone",
    "success_conditions",
    "evidence_requirements",
    "termination"
  ],
  "properties": {
    "schema_version": {"const": "controller-milestone-v1"},
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "goal"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1}
      }
    },
    "success_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence_requirement_ids"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "statement": {"type": "string", "minLength": 1},
          "evidence_requirement_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "kind", "source_id", "freshness_seconds", "provenance_required", "substitution_policy", "parameters"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "statement": {"type": "string", "minLength": 1},
          "kind": {"enum": ["VERIFICATION", "REAL"]},
          "source_id": {"$ref": "#/$defs/id"},
          "freshness_seconds": {"type": "integer", "minimum": 1},
          "provenance_required": {"const": true},
          "substitution_policy": {"const": "FORBIDDEN"},
          "parameters": {"type": "object"}
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_iterations",
        "max_stagnant_iterations",
        "max_environment_retries",
        "max_no_plan_rounds",
        "max_wall_seconds"
      ],
      "properties": {
        "max_iterations": {"type": "integer", "minimum": 1},
        "max_stagnant_iterations": {"type": "integer", "minimum": 1},
        "max_environment_retries": {"type": "integer", "minimum": 1},
        "max_no_plan_rounds": {"type": "integer", "minimum": 1},
        "max_wall_seconds": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    }
  }
}
