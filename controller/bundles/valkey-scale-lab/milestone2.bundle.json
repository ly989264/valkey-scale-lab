{
  "schema_version": "vpro-bundle-v1",
  "milestone": {
    "id": "Milestone2NativeMultiECS",
    "version": "1.0.0",
    "title": "Native multi-ECS execution",
    "goal": "Move the complete Milestone 1 contract to directly managed Valkey processes on multiple owned ECS instances through 200 real nodes."
  },
  "clauses": [
    {"id": "M2ScenarioParity", "text": "Execute one runtime-agnostic scenario contract locally or on ECS without duplicating lifecycle, management, stability, fault, analysis, or report logic."},
    {"id": "M2InventoryPlacement", "text": "Provide owned ECS inventory and deterministic host and virtual-AZ placement for every Valkey process."},
    {"id": "M2NativeProcesses", "text": "Distribute binaries and configuration and directly start, stop, probe, log, and clean up attributable Valkey host processes without Docker."},
    {"id": "M2RestartSafeJournal", "text": "Use centralized control with per-host journals and restart-safe idempotent remote commands across controller, session, host, and process failures."},
    {"id": "M2DistributedLifecycle", "text": "Run the complete management, stability, fault, failover, recovery, metric, artifact, analysis, and report lifecycle across multiple hosts."},
    {"id": "M2RunScopedSafety", "text": "Confine files, processes, ports, faults, reboots, and teardown to explicitly owned resources; never mutate host-global networking by default."},
    {"id": "M2ClockIdentity", "text": "Record host and clock identity with measured offsets so cross-host failover and recovery timelines remain defensible."},
    {"id": "M2ArtifactCompatibility", "text": "Preserve versioned artifact schemas and report compatibility while exposing host, AZ, transport, and clock uncertainty."},
    {"id": "M2TelemetryAttribution", "text": "Distinguish controller delay, remote-command delay, host pressure, network effects, Valkey work, and artifact-transfer time."},
    {"id": "M2RealThrough200", "text": "Pass representative cross-host and cross-AZ multi-ECS layouts through exact 200 real Valkey nodes."},
    {"id": "M2OperatorControls", "text": "Enforce and audit quota, credentials, ownership tags, resource and cost preflight, authorization, and deterministic teardown."}
  ],
  "tiers": [
    {"id": "cheap", "rank": 0, "cost": "cheap", "reviewer_admissible": true},
    {"id": "normal", "rank": 1, "cost": "normal", "reviewer_admissible": true},
    {"id": "expensive", "rank": 2, "cost": "expensive", "reviewer_admissible": false},
    {"id": "operator", "rank": 3, "cost": "operator", "reviewer_admissible": false}
  ],
