{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:valkey-scale-lab:controller:verification-receipts:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "product_digest", "milestone_digest", "catalog_digest", "generated_at_unix", "producer_digest", "toolchain_digest", "receipts", "envelope_digest"],
  "properties": {
    "schema_version": {"const": "verification-receipts-v2"},
    "run_id": {"type": "string", "minLength": 1},
    "product_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "milestone_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at_unix": {"type": "integer", "minimum": 1},
    "producer_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "toolchain_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "envelope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suite_id", "suite_definition_digest", "status", "run_id", "product_digest", "started_at_unix", "captured_at_unix", "exit_code", "skipped", "command_digest", "log", "suite_result", "producer_digest", "toolchain_digest", "receipt_digest"],
        "properties": {
          "suite_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "suite_definition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
          "run_id": {"type": "string", "minLength": 1},
          "product_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "started_at_unix": {"type": "integer", "minimum": 1},
          "captured_at_unix": {"type": "integer", "minimum": 1},
          "exit_code": {"type": "integer"},
          "skipped": {"type": "integer", "minimum": 0},
          "command_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "log": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "suite_result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "producer_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "toolchain_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
