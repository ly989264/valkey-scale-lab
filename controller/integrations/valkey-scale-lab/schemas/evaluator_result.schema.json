{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:valkey-scale-lab:vpro2:evaluator-result:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluator_id",
    "run_id",
    "product_digest",
    "input_digest",
    "condition_results",
    "evidence_results",
    "facts"
  ],
  "properties": {
    "schema_version": {"const": "vpro2-evaluator-result-v1"},
    "evaluator_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "product_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "condition_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition_id", "status", "summary"],
        "properties": {
          "condition_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "MISSING", "BLOCKED_ENV", "ERROR", "STALE"]},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "artifact", "capture_class", "provenance", "captured_at_unix", "run_id", "product_digest", "substituted"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "MISSING", "STALE", "UNTRUSTED", "SUBSTITUTED", "ERROR"]},
          "artifact": {"type": "string"},
          "capture_class": {"enum": ["REAL", "OTHER"]},
          "provenance": {"type": "object"},
          "captured_at_unix": {"type": "integer"},
          "run_id": {"type": "string", "minLength": 1},
          "product_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "substituted": {"const": false}
        }
      }
    },
    "facts": {"type": "array", "maxItems": 0}
  }
}
