{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:valkey-scale-lab:verification-results:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "product_digest", "milestone_digest", "catalog_digest", "generated_at_unix", "results", "bundle_digest"],
  "properties": {
    "schema_version": {"const": "verification-results-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "product_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "milestone_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at_unix": {"type": "integer", "minimum": 1},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suite_id", "suite_definition_digest", "status", "run_id", "product_digest", "started_at_unix", "captured_at_unix", "exit_code", "skipped", "log", "structured_result", "result_digest"],
        "properties": {
          "suite_id": {"type": "string", "minLength": 1},
          "suite_definition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
          "run_id": {"type": "string", "minLength": 1},
          "product_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "started_at_unix": {"type": "integer", "minimum": 1},
          "captured_at_unix": {"type": "integer", "minimum": 1},
          "exit_code": {"type": "integer"},
          "skipped": {"type": "integer", "minimum": 0},
          "log": {"$ref": "#/$defs/file"},
          "structured_result": {"$ref": "#/$defs/file"},
          "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
