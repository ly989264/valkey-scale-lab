{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:valkey-scale-lab:prerequisite-completion:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "milestone_id", "terminal_status", "product_digest", "completed_at_unix", "final_evidence_requirement_id", "final_admission_digest", "terminal_result", "completion_digest"],
  "properties": {
    "schema_version": {"const": "valkey-prerequisite-completion-v1"},
    "milestone_id": {"type": "string", "pattern": "^m[1-9][0-9]*$"},
    "terminal_status": {"const": "SUCCESS"},
    "product_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "completed_at_unix": {"type": "integer", "minimum": 1},
    "final_evidence_requirement_id": {"type": "string", "minLength": 1},
    "final_admission_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminal_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "terminal.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "completion_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
