{
  "schema_version": "valkey-controller-run-policy-v1",
  "allowed_write_paths": [
    "src",
    "templates",
    "docs",
    "scripts",
    "README.md",
    "pyproject.toml"
  ],
  "protected_paths": [
    "milestones",
    "verification",
    "tests",
    "src/valkey_scale_lab/scenarios/definitions"
  ],
  "evidence_freshness_seconds": 86400,
  "termination": {
    "max_iterations": 12,
    "max_stagnant_iterations": 3,
    "max_environment_retries": 3,
    "max_no_plan_rounds": 3,
    "max_wall_seconds": 86400
  }
}
