{
  "schema_version": "valkey-vpro2-controller-policy-v1",
  "evidence_freshness_seconds": 86400,
  "evaluator_timeout_seconds": 300,
  "capability_limits": {
    "docker": {"max_uses": 4, "cost_units_per_use": 10},
    "host_resource": {"max_uses": 8, "cost_units_per_use": 5},
    "cloud": {"max_uses": 8, "cost_units_per_use": 25}
  },
  "resource_budget": {
    "max_iterations": 12,
    "max_objective_attempts": 24,
    "max_planning_rounds_per_iteration": 3,
    "max_wall_seconds": 86400,
    "max_worker_seconds": 43200,
    "max_evaluator_seconds": 3600,
    "max_cost_units": 1000,
    "max_context_bytes": 2000000,
    "max_write_bytes": 500000000,
    "max_evidence_bytes": 4000000000,
    "max_transaction_bytes": 1000000000,
    "max_capability_runs": 24,
    "max_operator_runs": 24,
    "max_diagnostic_iterations": 3
  },
  "termination": {
    "max_consecutive_no_material_progress": 3,
    "max_consecutive_environment_blocked": 3,
    "max_no_legal_plan_rounds": 3,
    "integrity_anomaly": "FAIL_IMMEDIATE",
    "budget_exhaustion": "FAIL",
    "operator_abort": "FAIL"
  }
}
